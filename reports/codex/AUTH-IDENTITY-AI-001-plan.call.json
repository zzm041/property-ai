tenant)\n   19:         self._session.flush()\n   20:         return tenant\n   21: \n   22:     def add_property(self, property_record: Property) -> Property:\n   23:         self._session.add(property_record)\n   24:         self._session.flush()\n   25:         return property_record\n   26: \n   27:     def add_building(self, building: Building) -> Building:\n   28:         self._session.add(building)\n   29:         self._session.flush()\n   30:         return building\n   31: \n   32:     def add_unit(self, unit: Unit) -> Unit:\n   33:         self._session.add(unit)\n   34:         self._session.flush()\n   35:         return unit\n   36: \n   37:     def add_house(self, house: House) -> House:\n   38:         self._session.add(house)\n   39:         self._session.flush()\n   40:         return house\n   41: \n   42:     def get_tenant(self, tenant_id: int) -> Tenant | None:\n   43:         return self._session.scalar(\n   44:             select(Tenant).where(Tenant.id == tenant_id)\n   45:         )\n   46: \n   47:     def get_property(self, *, tenant_id: int, property_id: int) -> Property | None:\n   48:         return self._session.scalar(\n   49:             select(Property).where(\n   50:                 Property.id == property_id,\n   51:                 Property.tenant_id == tenant_id,\n   52:             )\n   53:         )\n   54: \n   55:     def get_property_by_id(self, property_id: int) -> Property | None:\n   56:         return self._session.get(Property, property_id)\n   57: \n   58:     def get_building(\n   59:         self,\n   60:         *,\n   61:         tenant_id: int,\n   62:         property_id: int,\n   63:         building_id: int,\n   64:     ) -> Building | None:\n   65:         return self._session.scalar(\n   66:             select(Building).where(\n   67:                 Building.id == building_id,\n   68:                 Building.tenant_id == tenant_id,\n   69:                 Building.property_id == property_id,\n   70:             )\n   71:         )\n   72: \n   73:     def get_unit(\n   74:         self,\n   75:         *,\n   76:         tenant_id: int,\n   77:         property_id: int,\n   78:         unit_id: int,\n   79:     ) -> Unit | None:\n   80:         return self._session.scalar(\n   81:             select(Unit).where(\n   82:                 Unit.id == unit_id,\n   83:                 Unit.tenant_id == tenant_id,\n   84:                 Unit.property_id == property_id,\n   85:             )\n   86:         )\n   87: \n   88:     def get_house(\n   89:         self,\n   90:         *,\n   91:         tenant_id: int,\n   92:         property_id: int,\n   93:         house_id: int,\n   94:     ) -> House | None:\n   95:         return self._session.scalar(\n   96:             select(House).where(\n   97:                 House.id == house_id,\n   98:                 House.tenant_id == tenant_id,\n   99:                 House.property_id == property_id,\n  100:             )\n  101:         )\n  102: \n  103:     def list_properties(\n  104:         self,\n  105:         *,\n  106:         tenant_id: int,\n  107:         after_id: int = 0,\n  108:         limit: int = 100,\n  109:     ) -> Sequence[Property]:\n  110:         return self._session.scalars(\n  111:             select(Property)\n  112:             .where(\n  113:                 Property.tenant_id == tenant_id,\n  114:                 Property.id > after_id,\n  115:             )\n  116:             .order_by(Property.id)\n  117:             .limit(limit)\n  118:         ).all()\n  119: \n  120:     def list_buildings(\n  121:         self,\n  122:         *,\n  123:         tenant_id: int,\n  124:         property_id: int,\n  125:         after_id: int = 0,\n  126:         limit: int = 100,\n  127:     ) -> Sequence[Building]:\n  128:         return self._session.scalars(\n  129:             select(Building)\n  130:             .where(\n  131:                 Building.tenant_id == tenant_id,\n  132:                 Building.property_id == property_id,\n  133:                 Building.id > after_id,\n  134:             )\n  135:             .order_by(Building.id)\n  136:             .limit(limit)\n  137:         ).all()\n  138: \n  139:     def list_units(\n  140:         self,\n  141:         *,\n  142:         tenant_id: int,\n  143:         property_id: int,\n  144:         building_id: int,\n  145:         after_id: int = 0,\n  146:         limit: int = 100,\n  147:     ) -> Sequence[Unit]:\n  148:         return self._session.scalars(\n  149:             select(Unit)\n  150:             .where(\n  151:                 Unit.tenant_id == tenant_id,\n  152:                 Unit.property_id == property_id,\n  153:                 Unit.building_id == building_id,\n  154:                 Unit.id > after_id,\n  155:             )\n  156:             .order_by(Unit.id)\n  157:             .limit(limit)\n  158:         ).all()\n  159: \n  160:     def list_houses(\n  161:         self,\n  162:         *,\n  163:         tenant_id: int,\n  164:         property_id: int,\n  165:         unit_id: int,\n  166:         after_id: int = 0,\n  167:         limit: int = 100,\n  168:     ) -> Sequence[House]:\n  169:         return self._session.scalars(\n  170:             select(House)\n  171:             .where(\n  172:                 House.tenant_id == tenant_id,\n  173:                 House.property_id == property_id,\n  174:                 House.unit_id == unit_id,\n  175:                 House.id > after_id,\n  176:             )\n  177:             .order_by(House.id)\n  178:             .limit(limit)\n  179:         ).all()\n### backend/app/service/property.py\n    1: \"\"\"Transactional use cases for Tenant and physical Property hierarchy creation.\"\"\"\n    2: \n    3: from collections.abc import Callable\n    4: from typing import NoReturn, TypeVar\n    5: \n    6: from sqlalchemy.exc import IntegrityError\n    7: from sqlalchemy.orm import Session\n    8: \n    9: from app.core.errors import AppError\n   10: from app.core.time import validate_timezone\n   11: from app.model.property import Building, House, Property, Tenant, Unit\n   12: from app.repository.property import PropertyRepository\n   13: \n   14: T = TypeVar(\"T\")\n   15: \n   16: INVALID_INPUT = \"RES.INVALID_INPUT\"\n   17: DUPLICATE_RESOURCE = \"RES.DUPLICATE_RESOURCE\"\n   18: HIERARCHY_NOT_FOUND = \"RES.HIERARCHY_NOT_FOUND\"\n   19: HIERARCHY_CONFLICT = \"RES.HIERARCHY_CONFLICT\"\n   20: \n   21: \n   22: def _required_text(value: str, field: str) -> str:\n   23:     normalized = value.strip()\n   24:     if not normalized:\n   25:         raise AppError(\n   26:             code=INVALID_INPUT,\n   27:             message=f\"{field} must not be empty\",\n   28:             status_code=422,\n   29:             details={\"field\": field},\n   30:         )\n   31:     return normalized\n   32: \n   33: \n   34: class PropertyService:\n   35:     \"\"\"Own complete transaction boundaries; repositories never commit.\"\"\"\n   36: \n   37:     def __init__(\n   38:         self,\n   39:         session: Session,\n   40:         repository: PropertyRepository | None = None,\n   41:     ) -> None:\n   42:         self._session = session\n   43:         self._repository = repository or PropertyRepository(session)\n   44: \n   45:     def _execute(self, operation: Callable[[], T], *, composing: bool = False) -> T:\n   46:         from app.core.database import run_composing_transaction, run_owned_transaction\n   47: \n   48:         try:\n   49:             runner = run_composing_transaction if composing else run_owned_transaction\n   50:             return runner(self._session, operation)\n   51:         except IntegrityError as exc:\n   52:             error_number = getattr(exc.orig, \"args\", [None])[0]\n   53:             if error_number == 1062:\n   54:                 raise AppError(\n   55:                     code=DUPLICATE_RESOURCE,\n   56:                     message=\"A resource with the same business key already exists\",\n   57:                     status_code=409,\n   58:                 ) from exc\n   59:             raise AppError(\n   60:                 code=HIERARCHY_CONFLICT,\n   61:                 message=\"Property hierarchy constraint rejected the operation\",\n   62:                 status_code=409,\n   63:             ) from exc\n   64: \n   65:     def create_tenant(\n   66:         self,\n   67:         *,\n   68:         name: str,\n   69:         status: str = \"ACTIVE\",\n   70:         contact: str | None = None,\n   71:     ) -> Tenant:\n   72:         def operation() -> Tenant:\n   73:             return self._repository.add_tenant(\n   74:                 Tenant(\n   75:                     name=_required_text(name, \"name\"),\n   76:                     status=_required_text(status, \"status\"),\n   77:                     contact=contact.strip() if contact else None,\n   78:                 )\n   79:             )\n   80: \n   81:         return self._execute(operation)\n   82: \n   83:     def create_property(\n   84:         self,\n   85:         *,\n   86:         tenant_id: int,\n   87:         name: str,\n   88:         address: str,\n   89:         timezone: str = \"Asia/Shanghai\",\n   90:     ) -> Property:\n   91:         def operation() -> Property:\n   92:             tenant = self._repository.get_tenant(tenant_id)\n   93:             if tenant is None:\n   94:                 self._raise_parent_not_found(\"Tenant\")\n   95:             try:\n   96:                 timezone_name = validate_timezone(timezone).key\n   97:             except ValueError as exc:\n   98:                 raise AppError(\n   99:                     code=INVALID_INPUT,\n  100:                     message=\"timezone must be a valid IANA timezone\",\n  101:                     status_code=422,\n  102:                     details={\"field\": \"timezone\"},\n  103:                 ) from exc\n  104:             return self._repository.add_property(\n  105:                 Property(\n  106:                     tenant_id=tenant.id,\n  107:                     name=_required_text(name, \"name\"),\n  108:                     address=_required_text(address, \"address\"),\n  109:                     timezone=timezone_name,\n  110:                 )\n  111:             )\n  112: \n  113:         return self._execute(operation)\n  114: \n  115:     def create_building(\n  116:         self,\n  117:         *,\n  118:         tenant_id: int,\n  119:         property_id: int,\n  120:         code: str,\n  121:         name: str,\n  122:     ) -> Building:\n  123:         def operation() -> Building:\n  124:             property_record = self._repository.get_property(\n  125:                 tenant_id=tenant_id,\n  126:                 property_id=property_id,\n  127:             )\n  128:             if property_record is None:\n  129:                 self._raise_parent_not_found(\"Property\")\n  130:             return self._repository.add_building(\n  131:                 Building(\n  132:                     tenant_id=property_record.tenant_id,\n  133:                     property_id=property_record.id,\n  134:                     code=_required_text(code, \"code\"),\n  135:                     name=_required_text(name, \"name\"),\n  136:                 )\n  137:             )\n  138: \n  139:         return self._execute(operation)\n  140: \n  141:     def create_unit(\n  142:         self,\n  143:         *,\n  144:         tenant_id: int,\n  145:         property_id: int,\n  146:         building_id: int,\n  147:         code: str,\n  148:         name: str,\n  149:     ) -> Unit:\n  150:         def operation() -> Unit:\n  151:             building = self._repository.get_building(\n  152:                 tenant_id=tenant_id,\n  153:                 property_id=property_id,\n  154:                 building_id=building_id,\n  155:             )\n  156:             if building is None:\n  157:                 self._raise_parent_not_found(\"Building\")\n  158:             return self._repository.add_unit(\n  159:                 Unit(\n  160:                     tenant_id=building.tenant_id,\n  161:                     property_id=building.property_id,\n  162:                     building_id=building.id,\n  163:                     code=_required_text(code, \"code\"),\n  164:                     name=_required_text(name, \"name\"),\n  165:                 )\n  166:             )\n  167: \n  168:         return self._execute(operation)\n  169: \n  170:     def create_house(\n  171:         self,\n  172:         *,\n  173:         tenant_id: int,\n  174:         property_id: int,\n  175:         unit_id: int,\n  176:         room_no: str,\n  177:         floor: int | None = None,\n  178:         status: str = \"ACTIVE\",\n  179:     ) -> House:\n  180:         def operation() -> House:\n  181:             unit = self._repository.get_unit(\n  182:                 tenant_id=tenant_id,\n  183:                 property_id=property_id,\n  184:                 unit_id=unit_id,\n  185:             )\n  186:             if unit is None:\n  187:                 self._raise_parent_not_found(\"Unit\")\n  188:             return self._repository.add_house(\n  189:                 House(\n  190:                     tenant_id=unit.tenant_id,\n  191:                     property_id=unit.property_id,\n  192:                     unit_id=unit.id,\n  193:                     room_no=_required_text(room_no, \"room_no\"),\n  194:                     floor=floor,\n  195:                     status=_required_text(status, \"status\"),\n  196:                 )\n  197:             )\n  198: \n  199:         return self._execute(operation)\n  200: \n  201:     @staticmethod\n  202:     def _raise_parent_not_found(parent: str) -> NoReturn:\n  203:         raise AppError(\n  204:             code=HIERARCHY_NOT_FOUND,\n  205:             message=f\"{parent} was not found in the requested scope\",\n  206:             status_code=404,\n  207:         )\n### backend/app/api/v1/resident.py\n    1: \"\"\"Resident bind-request and current-house routes.\"\"\"\n    2: \n    3: from typing import Annotated\n    4: \n    5: from fastapi import APIRouter, Depends, Query, Request\n    6: from sqlalchemy.orm import Session\n    7: \n    8: from app.api.dependencies.auth import get_current_principal\n    9: from app.api.dependencies.db import get_db_session\n   10: from app.domain.iam import Principal\n   11: from app.schema.common import request_id_for, success_envelope\n   12: from app.schema.resident import (\n   13:     BindRequestListData,\n   14:     CreateResidentBindRequest,\n   15:     HouseRelationListData,\n   16:     ResidentBindRequestData,\n   17:     ResidentHouseData,\n   18: )\n   19: from app.service.resident import ResidentBindingService\n   20: \n   21: router = APIRouter(tags=[\"resident-binding\"])\n   22: \n   23: \n   24: def get_resident_binding_service(\n   25:     session: Annotated[Session, Depends(get_db_session)],\n   26: ) -> ResidentBindingService:\n   27:     return ResidentBindingService(session)\n   28: \n   29: \n   30: def _request_data(record) -> ResidentBindRequestData:\n   31:     return ResidentBindRequestData(\n   32:         id=record.id,\n   33:         user_id=record.user_id,\n   34:         tenant_id=record.tenant_id,\n   35:         property_id=record.property_id,\n   36:         house_id=record.house_id,\n   37:         relation_type=record.relation_type,\n   38:         status=record.status,\n   39:         reviewer_id=record.reviewer_id,\n   40:         review_reason=record.review_reason,\n   41:         requested_at=record.requested_at,\n   42:         reviewed_at=record.reviewed_at,\n   43:     )\n   44: \n   45: \n   46: @router.post(\"/resident-bind-requests\")\n   47: def create_resident_bind_request(\n   48:     body: CreateResidentBindRequest,\n   49:     request: Request,\n   50:     actor: Annotated[Principal, Depends(get_current_principal)],\n   51:     service: Annotated[\n   52:         ResidentBindingService, Depends(get_resident_binding_service)\n   53:     ],\n   54: ) -> dict[str, object]:\n   55:     record = service.create_bind_request(\n   56:         actor=actor,\n   57:         house_id=body.house_id,\n   58:         relation_type=body.relation_type.value,\n   59:         request_id=request_id_for(request),\n   60:         claimed_tenant_id=body.tenant_id,\n   61:         claimed_property_id=body.property_id,\n   62:     )\n   63:     return success_envelope(\n   64:         request,\n   65:         _request_data(record).model_dump(mode=\"json\"),\n   66:     )\n   67: \n   68: \n   69: @router.get(\"/resident-bind-requests/mine\")\n   70: def list_my_resident_bind_requests(\n   71:     request: Request,\n   72:     actor: Annotated[Principal, Depends(get_current_principal)],\n   73:     service: Annotated[\n   74:         ResidentBindingService, Depends(get_resident_binding_service)\n   75:     ],\n   76:     after_id: Annotated[int, Query(ge=0)] = 0,\n   77:     limit: Annotated[int, Query(ge=1, le=100)] = 50,\n   78: ) -> dict[str, object]:\n   79:     records = service.list_my_bind_requests(\n   80:         actor=actor,\n   81:         after_id=after_id,\n   82:         limit=limit,\n   83:     )\n   84:     items = [_request_data(record) for record in records]\n   85:     next_cursor = items[-1].id if len(items) == limit else None\n   86:     return success_envelope(\n   87:         request,\n   88:         BindRequestListData(items=items, next_cursor=next_cursor).model_dump(\n   89:             mode=\"json\"\n   90:         ),\n   91:     )\n   92: \n   93: \n   94: @router.get(\"/me/houses\")\n   95: def list_my_houses(\n   96:     request: Request,\n   97:     actor: Annotated[Principal, Depends(get_current_principal)],\n   98:     service: Annotated[\n   99:         ResidentBindingService, Depends(get_resident_binding_service)\n  10