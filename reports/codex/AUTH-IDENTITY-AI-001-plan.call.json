            code=WorkOrderErrorCode.INVALID_TRANSITION,\n 2019:                 message=\"Work order transition is not allowed\",\n 2020:                 status_code=409,\n 2021:             ) from exc\n 2022:         if to_status is WorkOrderStatus.PROCESSING:\n 2023:             target_reason = process_reason or ProcessReason(record.process_reason)\n 2024:         else:\n 2025:             target_reason = ProcessReason.NONE\n 2026:         record.status = to_status.value\n 2027:         record.process_reason = target_reason.value\n 2028:         record.version += 1\n 2029:         self._write_log(\n 2030:             record,\n 2031:             actor=actor,\n 2032:             actor_type=actor_type,\n 2033:             from_status=from_status,\n 2034:             to_status=to_status,\n 2035:             event=event,\n 2036:             request_id=request_id,\n 2037:             reason_code=reason_code,\n 2038:         )\n 2039:         self._session.flush()\n 2040: \n 2041:     def _write_log(\n 2042:         self,\n 2043:         record: WorkOrder,\n 2044:         *,\n 2045:         actor: Principal,\n 2046:         actor_type: WorkOrderActorType,\n 2047:         from_status: WorkOrderStatus | None,\n 2048:         to_status: WorkOrderStatus,\n 2049:         event: WorkOrderEvent,\n 2050:         request_id: str,\n 2051:         reason_code: str | None = None,\n 2052:     ) -> None:\n 2053:         payload: dict[str, object] = {\"event_code\": event.value}\n 2054:         if reason_code is not None:\n 2055:             payload[\"reason_code\"] = reason_code\n 2056:         self._repository.add_log(\n 2057:             WorkOrderLog(\n 2058:                 tenant_id=record.tenant_id,\n 2059:                 property_id=record.property_id,\n 2060:                 work_order_id=record.id,\n 2061:                 actor_user_id=actor.user_id,\n 2062:                 actor_type=actor_type.value,\n 2063:                 from_status=None if from_status is None else from_status.value,\n 2064:                 to_status=to_status.value,\n 2065:                 process_reason=record.process_reason,\n 2066:                 event_code=event.value,\n 2067:                 request_id=request_id,\n 2068:                 payload_json=payload,\n 2069:             )\n 2070:         )\n 2071: \n 2072:     def _create_assignment(\n 2073:         self,\n 2074:         record: WorkOrder,\n 2075:         *,\n 2076:         employee: Employee,\n 2077:         actor: Principal,\n 2078:         now: datetime,\n 2079:         reason: str | None,\n 2080:     ) -> WorkOrderAssignment:\n 2081:         return self._repository.add_assignment(\n 2082:             WorkOrderAssignment(\n 2083:                 tenant_id=record.tenant_id,\n 2084:                 property_id=record.property_id,\n 2085:                 work_order_id=record.id,\n 2086:                 employee_id=employee.id,\n 2087:                 assigned_by_user_id=actor.user_id,\n 2088:                 status=AssignmentStatus.ACTIVE.value,\n 2089:                 assigned_at=now,\n 2090:                 reason=reason,\n 2091:             )\n 2092:         )\n 2093: \n 2094:     def _end_active_assignment(\n 2095:         self,\n 2096:         record: WorkOrder,\n 2097:         *,\n 2098:         now: datetime,\n 2099:         status: AssignmentStatus,\n 2100:         reason: str | None = None,\n 2101:     ) -> None:\n 2102:         assignment = self._repository.get_active_assignment_for_update(record.id)\n 2103:         if assignment is None:\n 2104:             return\n 2105:         assignment.status = status.value\n 2106:         assignment.ended_at = now\n 2107:         if reason is not None:\n 2108:             assignment.reason = reason\n 2109:         employee = self._employees.get_employee(assignment.employee_id)\n 2110:         if employee is not None:\n 2111:             self._adjust_load(record, employee, delta=-1)\n 2112:         record.current_assignment_id = None\n 2113:         self._session.flush()\n 2114: \n 2115:     def _adjust_load(\n 2116:         self,\n 2117:         record: WorkOrder,\n 2118:         employee: Employee,\n 2119:         *,\n 2120:         delta: int,\n 2121:     ) -> None:\n 2122:         property_record = self._repository.get_property(record.property_id)\n 2123:         if property_record is None:\n 2124:             return\n 2125:         business_date = current_business_date(\n 2126:             property_record.timezone,\n 2127:             clock=self._clock,\n 2128:         )\n 2129:         daily = self._employees.get_daily_status_for_update(\n 2130:             employee_id=employee.id,\n 2131:             property_id=record.property_id,\n 2132:             business_date=business_date,\n 2133:         )\n 2134:         if daily is None:\n 2135:             return\n 2136:         daily.current_load = max(daily.current_load + delta, 0)\n 2137:         self._session.flush()\n 2138: \n 2139:     def _eligibility_error(\n 2140:         self,\n 2141:         record: WorkOrder,\n 2142:         employee: Employee,\n 2143:         *,\n 2144:         ignore_capacity: bool = False,\n 2145:     ) -> AppError | None:\n 2146:         denied = AppError(\n 2147:             code=WorkOrderErrorCode.EMPLOYEE_NOT_ELIGIBLE,\n 2148:             message=\"Employee is not eligible for dispatch\",\n 2149:             status_code=409,\n 2150:         )\n 2151:         if employee.status != EmployeeStatus.ACTIVE.value:\n 2152:             return denied\n 2153:         if employee.tenant_id != record.tenant_id:\n 2154:             return denied\n 2155:         now = self._clock()\n 2156:         assignment = self._employees.find_effective_assignment(\n 2157:             employee_id=employee.id,\n 2158:             property_id=record.property_id,\n 2159:             now=now,\n 2160:         )\n 2161:         if assignment is None:\n 2162:             return denied\n 2163:         property_record = self._repository.get_property(record.property_id)\n 2164:         if property_record is None:\n 2165:             return denied\n 2166:         business_date = current_business_date(\n 2167:             property_record.timezone,\n 2168:             clock=self._clock,\n 2169:         )\n 2170:         daily = self._employees.get_daily_status_for_update(\n 2171:             employee_id=employee.id,\n 2172:             property_id=record.property_id,\n 2173:             business_date=business_date,\n 2174:         )\n 2175:         if daily is None or daily.on_duty != AttendanceOnDuty.ON_DUTY.value:\n 2176:             return denied\n 2177:         if not ignore_capacity and not employee_is_capacity_available(\n 2178:             current_load=daily.current_load,\n 2179:             max_capacity=employee.max_capacity,\n 2180:         ):\n 2181:             return denied\n 2182:         return None\n 2183: \n 2184:     def _attach_media(\n 2185:         self,\n 1120:             details={\"work_order_id\": record.id, \"status\": record.status},\n 1121:         )\n 1122:         return record\n 1123: \n 1124:     def _reopen(\n 1125:         self,\n 1126:         *,\n 1127:         actor: Principal,\n 1128:         work_order_id: int,\n 1129:         request_id: str,\n 1130:         reason: str,\n 1131:         version: int | None,\n 1132:     ) -> WorkOrder:\n 1133:         current = self._reload_actor(actor)\n 1134:         record = self._lock_work_order(work_order_id)\n 1135:         self._assert_version(record, version)\n 1136:         self._require_reporter(current, record)\n 1137:         assignment = self._repository.get_active_assignment_for_update(record.id)\n 1138:         employee = None\n 1139:         if assignment is not None:\n 1140:             employee = self._employees.get_employee(assignment.employee_id)\n 1141:         eligible = (\n 1142:             employee is not None\n 1143:             and self._eligibility_error(\n 1144:                 record,\n 1145:                 employee,\n 1146:                 ignore_capacity=True,\n 1147:             )\n 1148:             is None\n 1149:         )\n 1150:         process = self._repository.get_current_process(record.id)\n 1151:         self._repository.add_feedback(\n 1152:             WorkOrderFeedback(\n 1153:                 tenant_id=record.tenant_id,\n 1154:                 property_id=record.property_id,\n 1155:                 work_order_id=record.id,\n 1156:                 process_id=None if process is None else process.id,\n 1157:                 actor_user_id=current.user_id,\n 1158:                 confirmed=0,\n 1159:                 unresolved_flag=1,\n 1160:                 comment=reason,\n 1161:             )\n 1162:         )\n 1163:         if eligible and employee is not None:\n 1164:             self._apply_transition(\n 1165:                 record,\n 1166:                 event=WorkOrderEvent.REOPEN,\n 1167:                 to_status=WorkOrderStatus.PROCESSING,\n 1168:                 actor=current,\n 1169:                 actor_type=WorkOrderActorType.RESIDENT,\n 1170:                 request_id=request_id,\n 1171:                 reason_code=\"REOPEN\",\n 1172:             )\n 1173:             next_cycle = 1 if process is None else process.cycle_no + 1\n 1174:             self._repository.add_process(\n 1175:                 WorkOrderProcess(\n 1176:                     tenant_id=record.tenant_id,\n 1177:                     property_id=record.property_id,\n 1178:                     work_order_id=record.id,\n 1179:                     cycle_no=next_cycle,\n 1180:                     assignee_id=employee.id,\n 1181:                     started_at=self._clock(),\n 1182:                 )\n 1183:             )\n 1184:         else:\n 1185:             self._end_active_assignment(\n 1186:                 record,\n 1187:                 now=self._clock(),\n 1188:                 status=AssignmentStatus.ENDED,\n 1189:             )\n 1190:             self._apply_transition(\n 1191:                 record,\n 1192:                 event=WorkOrderEvent.REOPEN,\n 1193:                 to_status=WorkOrderStatus.PENDING_ASSIGNMENT,\n 1194:                 actor=current,\n 1195:                 actor_type=WorkOrderActorType.RESIDENT,\n 1196:                 request_id=request_id,\n 1197:                 reason_code=\"REOPEN\",\n 1198:             )\n 1199:         self._append_audit(\n 1200:             action=AuditAction.WORK_ORDER_REOPENED,\n 1201:             resource_type=AuditResourceType.WORK_ORDER,\n 1202:             actor_user_id=current.user_id,\n 1203:             resource_id=record.id,\n 1204:             request_id=request_id,\n 1205:             tenant_id=record.tenant_id,\n 1206:             property_id=record.property_id,\n 1207:             details={\n 1208:                 \"work_order_id\": record.id,\n 1209:                 \"status\": record.status,\n 1210:                 \"reason_code\": \"REOPEN\",\n    1: \"\"\"Persistence helpers for AI analysis, incidents, and announcements.\"\"\"\n    2: \n    3: from datetime import datetime\n    4: \n    5: from sqlalchemy import select\n    6: from sqlalchemy.orm import Session\n    7: \n    8: from app.model.ai import (\n    9:     AiCallLog,\n   10:     Announcement,\n   11:     AnnouncementReview,\n   12:     AnnouncementScope,\n   13:     DispatchRecommendation,\n   14:     Incident,\n   15:     IncidentWorkOrder,\n   16:     Notification,\n   17:     WorkOrderAnalysis,\n   18: )\n   19: from app.model.employee import (\n   20:     Duty,\n   21:     Employee,\n   22:     EmployeeDailyStatus,\n   23:     EmployeeDuty,\n   24:     EmployeeProperty,\n   25:     EmployeeSkill,\n   26:     Skill,\n   27: )\n   28: from app.model.identity import Role, UserRole\n   29: from app.model.property import House, Unit\n   30: from app.model.work_order import FileObject, WorkOrder, WorkOrderMedia\n   31: \n   32: \n   33: class AiRepository:\n   34:     def __init__(self, session: Session) -> None:\n   35:         self._session = session\n   36: \n   37:     def get_analysis(self, analysis_id: int) -> WorkOrderAnalysis | None:\n   38:         return self._session.get(WorkOrderAnalysis, analysis_id)\n   39: \n   40:     def get_current_analysis(self, work_order_id: int) -> WorkOrderAnalysis | None:\n   41:         return self._session.scalar(\n   42:             select(WorkOrderAnalysis)\n   43:             .where(WorkOrderAnalysis.work_order_id == work_order_id)\n   44:             .order_by(WorkOrderAnalysis.analysis_version.desc())\n   45:             .limit(1)\n   46:         )\n   47: \n   48:     def get_current_analysis_for_update(\n   49:         self,\n   50:         work_order_id: int,\n   51:     ) -> WorkOrderAnalysis | None:\n   52:         return self._session.scalar(\n   53:             select(WorkOrderAnalysis)\n   54:             .where(WorkOrderAnalysis.work_order_id == work_order_id)\n   55:             .order_by(WorkOrderAnalysis.analysis_version.desc())\n   56:             .limit(1)\n   57:             .with_for_update()\n   58:         )\n   59: \n   60:     def add_analysis(self, record: WorkOrderAnalysis) -> WorkOrderAnalysis:\n   61:         self._session.add(record)\n   62:         self._session.flush()\n   63:         return record\n   64: \n   65:     def add_call_log(self, record: AiCallLog) -> AiCallLog:\n   66:         self._session.add(record)\n   67:         self._session.flush()\n   68:         return record\n   69: \n   70:     def delete_recommendations(self, analysis_id: int) -> None:\n   71:         existing = self._session.scalars(\n   72:             select(DispatchRecommendation).where(\n   73:                 DispatchRecommendation.analysis_id == analysis_id\n   74:             )\n   75:         ).all()\n   76:         for item in existing:\n   77:             self._session.delete(item)\n   78:         self._session.flush()\n   79: \n   80:     def add_recommendation(\n   81:         self,\n   82:         record: DispatchRecommendation,\n   83:     ) -> DispatchRecommendation:\n   84:         self._session.add(record)\n   85:         self._session.flush()\n   86:         return record\n   87: \n   88:     def list_recommendations(\n   89:         self,\n   90:         work_order_id: int,\n   91:     ) -> tuple[DispatchRecommendation, ...]:\n   92:         return tuple(\n   93:             self._session.scalars(\n   94:                 select(DispatchRecommendation)\n   95:                 .where(DispatchRecommendation.work_order_id == work_order_id)\n   96:                 .order_by(\n   97:                     DispatchRecommendation.eligible.desc(),\n   98:                     DispatchRecommendation.rank_no,\n   99:                     DispatchRecommendation.id,\n  100:                 )\n  101:             ).all()\n  102:         )\n  103: \n  104:     def get_file(self, file_id: int) -> FileObject | None:\n  105:         return self._session.get(FileObject, file_id)\n  106: \n  107:     def get_building_id(self, house_id: int) -> int | None:\n  108:         house = self._session.get(House, house_id)\n  109:         if house is None:\n  110:             return None\n  111:         unit = self._session.get(Unit, house.unit_id)\n  112:         return None if unit is None else unit.building_id\n  113: \n  114:     def list_property_employees(self, *, tenant_id: int, property_id: int) -> tuple[Employee, ...]:\n  115:         return tuple(\n  116:             self._session.scalars(\n  117:                 select(Employee)\n  118:                 .join(\n  119:                     EmployeeProperty,\n  120:                     EmployeeProperty.employee_id == Employee.id,\n  121:                 )\n  122:                 .where(\n  123:                     Employee.tenant_id == tenant_id,\n  124:                     EmployeeProperty.tenant_id == tenant_id,\n  125:                     EmployeeProperty.property_id == property_id,\n  126:                 )\n  127:                 .distinct()\n  128:                 .order_by(Employee.id)\n  129:             ).all()\n  130:         )\n  131: \n  132:     def list_employee_duties(self, employee_id: int) -> frozenset[str]:\n  133:         rows = self._session.execute(\n  134:             select(Duty.code)\n  135:             .join(EmployeeDuty, EmployeeDuty.duty_id == Duty.id)\n  136:             .where(EmployeeDuty.employee_id == employee_id)\n  137:         ).all()\n  138:         return frozenset(row[0] for row in rows)\n  139: \n  140:     def list_employee_skills(self, employee_id: int) -> frozenset[str]:\n  141:         rows = self._session.execute(\n  142:             select(Skill.code)\n  143:             .join(EmployeeSkill, EmployeeSkill.skill_id == Skill.id)\n  144:             .where(EmployeeSkill.employee_id == employee_id)\n  145:         ).all()\n  146:         return frozenset(row[0] for row in rows)\n  147: \n  148:     def list_employee_role_codes(self, user_id: int) -> frozenset[str]:\n  149:         rows = self._session.execute(\n  150:             select(Role.code)\n  151:             .join(UserRole, UserRole.role_id == Role.id)\n  152:             .where(UserRole.user_id == user_id)\n  153:         ).all()\n  154:         return frozenset(row[0] for row in rows)\n  155: \n  156:     def get_effective_property(\n  157:         self,\n  158:         *,\n  159:         employee_id: int,\n  160:         property_id: int,\n  161:         now: datetime,\n  162:     ) -> EmployeeProperty | None:\n  163:         return self._session.scalar(\n  164:             select(EmployeeProperty).where(\n  165:                 EmployeeProperty.employee_id == employee_id,\n  166:                 EmployeeProperty.property_id == property_id,\n  167:                 EmployeeProperty.status == \"ACTIVE\",\n  168:                 EmployeeProperty.valid_from <= now,\n  169:                 (EmployeeProperty.valid_to.is_(None))\n  170:                 | (EmployeeProperty.valid_to > now),\n  171:             )\n  172:         )\n  173: \n  174:     def get_daily_status(\n  175:         self,\n  176:         *,\n  177:         employee_id: int,\n  178:         property_id: int,\n  179:         business_date,\n  180:     ) -> EmployeeDailyStatus | None:\n  181:         return self._session.scalar(\n  182:             select(EmployeeDailyStatus).where(\n  183:                 EmployeeDailyStatus.employee_id == employee_id,\n  184:                 EmployeeDailyStatus.property_id == property_id,\n  185:                 EmployeeDailyStatus.business_date == business_date,\n  186:             )\n  187:         )\n  188: \n  189:     def count_same_building_history(\n  190:         self,\n  191:         *,\n  192:         employee_id: int,\n  193:         building_id: int | None,\n  194:         tenant_id: int,\n  195:         property_id: int,\n  196:     ) -> int:\n  197:         if building_id is None:\n  198:             return 0\n  199:         rows = self._session.execute(\n  200:             select(WorkOrder.id)\n  201:             .join(House, House.id == WorkOrder.house_id)\n  202:             .join(Unit, Unit.id == House.unit_id)\n  203:             .where(\n  204:                 WorkOrder.tenant_id == tenant_id,\n  205:                 WorkOrder.property_id == property_id,\n  206:                 Unit.building_id == building_id,\n  207:                 WorkOrder.current_assignment_id.is_not(None),\n  208:             )\n  209:         ).all()\n  210:         del employee_id\n  211:         return len(rows)\n  212: \n  213:     def list_cluster_work_orders(\n  214:         self,\n  215:         *,\n  216:         tenant_id: int,\n  217:         property_id: int,\n  218:         building_id: int | None,\n  219:         category: str,\n  220:         since: datetime,\n  221:         until: datetime,\n  222:     ) -> tuple[WorkOrder, ...]:\n  223:         query = select(WorkOrder).where(\n  224:             WorkOrder.tenant_id == tenant_id,\n  225:             WorkOrde