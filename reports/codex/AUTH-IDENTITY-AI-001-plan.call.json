       return self._session.scalar(\n   56:             select(ResidentBindRequest).where(\n   57:                 ResidentBindRequest.id == request_id,\n   58:                 ResidentBindRequest.user_id == user_id,\n   59:             )\n   60:         )\n   61: \n   62:     def list_bind_requests_for_user(\n   63:         self,\n   64:         *,\n   65:         user_id: int,\n   66:         after_id: int = 0,\n   67:         limit: int = 50,\n   68:     ) -> tuple[ResidentBindRequest, ...]:\n   69:         return tuple(\n   70:             self._session.scalars(\n   71:                 select(ResidentBindRequest)\n   72:                 .where(\n   73:                     ResidentBindRequest.user_id == user_id,\n   74:                     ResidentBindRequest.id > after_id,\n   75:                 )\n   76:                 .order_by(ResidentBindRequest.id)\n   77:                 .limit(limit)\n   78:             ).all()\n   79:         )\n   80: \n   81:     def list_pending_requests_for_property(\n   82:         self,\n   83:         *,\n   84:         tenant_id: int,\n   85:         property_id: int,\n   86:         after_id: int = 0,\n   87:         limit: int = 50,\n   88:     ) -> tuple[ResidentBindRequest, ...]:\n   89:         return tuple(\n   90:             self._session.scalars(\n   91:                 select(ResidentBindRequest)\n   92:                 .where(\n   93:                     ResidentBindRequest.tenant_id == tenant_id,\n   94:                     ResidentBindRequest.property_id == property_id,\n   95:                     ResidentBindRequest.status == \"PENDING\",\n   96:                     ResidentBindRequest.id > after_id,\n   97:                 )\n   98:                 .order_by(ResidentBindRequest.id)\n   99:                 .limit(limit)\n  100:             ).all()\n  101:         )\n  102: \n  103:     def find_active_relation(\n  104:         self,\n  105:         *,\n  106:         user_id: int,\n  107:         house_id: int,\n  108:         now: datetime,\n  109:     ) -> ResidentHouseRelation | None:\n  110:         return self._session.scalar(\n  111:             select(ResidentHouseRelation).where(\n  112:                 ResidentHouseRelation.user_id == user_id,\n  113:                 ResidentHouseRelation.house_id == house_id,\n  114:                 ResidentHouseRelation.status == \"ACTIVE\",\n  115:                 ResidentHouseRelation.valid_from <= now,\n  116:                 or_(\n  117:                     ResidentHouseRelation.valid_to.is_(None),\n  118:                     ResidentHouseRelation.valid_to > now,\n  119:                 ),\n  120:             )\n  121:         )\n  122: \n  123:     def get_active_house_for_user(\n  124:         self,\n  125:         *,\n  126:         user_id: int,\n  127:         house_id: int,\n  128:         now: datetime,\n  129:     ) -> House | None:\n  130:         return self._session.scalar(\n  131:             select(House)\n  132:             .join(\n  133:                 ResidentHouseRelation,\n  134:                 (ResidentHouseRelation.house_id == House.id)\n  135:                 & (ResidentHouseRelation.tenant_id == House.tenant_id)\n  136:                 & (ResidentHouseRelation.property_id == House.property_id),\n  137:             )\n  138:             .where(\n  139:                 ResidentHouseRelation.user_id == user_id,\n  140:                 House.id == house_id,\n  141:                 ResidentHouseRelation.status == \"ACTIVE\",\n  142:                 ResidentHouseRelation.valid_from <= now,\n  143:                 or_(\n  144:                     ResidentHouseRelation.valid_to.is_(None),\n  145:                     ResidentHouseRelation.valid_to > now,\n  146:                 ),\n  147:             )\n  148:         )\n  149: \n  150:     def list_active_relations_for_user(\n  151:         self,\n  152:         *,\n  153:         user_id: int,\n  154:         now: datetime,\n  155:         after_id: int = 0,\n  156:         limit: int = 50,\n  157:     ) -> tuple[tuple[ResidentHouseRelation, House], ...]:\n  158:         rows = self._session.execute(\n  159:             select(ResidentHouseRelation, House)\n  160:             .join(\n  161:                 House,\n  162:                 (House.id == ResidentHouseRelation.house_id)\n  163:                 & (House.tenant_id == ResidentHouseRelation.tenant_id)\n  164:                 & (House.property_id == ResidentHouseRelation.property_id),\n  165:             )\n  166:             .where(\n  167:                 ResidentHouseRelation.user_id == user_id,\n  168:                 ResidentHouseRelation.status == \"ACTIVE\",\n  169:                 ResidentHouseRelation.valid_from <= now,\n  170:                 or_(\n  171:                     ResidentHouseRelation.valid_to.is_(None),\n  172:                     ResidentHouseRelation.valid_to > now,\n  173:                 ),\n  174:                 ResidentHouseRelation.id > after_id,\n  175:             )\n  176:             .order_by(ResidentHouseRelation.id)\n  177:             .limit(limit)\n  178:         ).all()\n  179:         return tuple((relation, house) for relation, house in rows)\n  180: \n  181:     def list_active_resident_user_ids(\n  182:         self,\n  183:         *,\n  184:         tenant_id: int,\n  185:         property_id: int,\n  186:         now: datetime,\n  187:     ) -> tuple[int, ...]:\n  188:         rows = self._session.scalars(\n  189:             select(ResidentHouseRelation.user_id)\n  190:             .where(\n  191:                 ResidentHouseRelation.tenant_id == tenant_id,\n  192:                 ResidentHouseRelation.property_id == property_id,\n  193:                 ResidentHouseRelation.status == \"ACTIVE\",\n  194:                 ResidentHouseRelation.valid_from <= now,\n  195:                 or_(\n  196:                     ResidentHouseRelation.valid_to.is_(None),\n  197:                     ResidentHouseRelation.valid_to > now,\n  198:                 ),\n  199:             )\n  200:             .distinct()\n  201:         ).all()\n  202:         return tuple(int(item) for item in rows)\n  203: \n  204:     def add_bind_request(\n  205:         self,\n  206:         request: ResidentBindRequest,\n  207:     ) -> ResidentBindRequest:\n  208:         self._session.add(request)\n  209:         self._session.flush()\n  210:         return request\n  211: \n  212:     def add_relation(\n  213:         self,\n  214:         relation: ResidentHouseRelation,\n  215:     ) -> ResidentHouseRelation:\n  216:         self._session.add(relation)\n  217:         self._session.flush()\n  218:         return relation\n  219: \n  220:     def end_relation(\n  221:         self,\n  222:         relation: ResidentHouseRelation,\n  223:         *,\n  224:         ended_at: datetime,\n  225:         status: str,\n  226:     ) -> ResidentHouseRelation:\n  227:         relation.valid_to = ended_at\n  228:         relation.status = status\n  229:         self._session.flush()\n  230:         return relation\n### backend/app/service/resident.py\n    1: \"\"\"Resident bind-request and house-relation use cases with atomic audit.\"\"\"\n    2: \n    3: from collections.abc import Callable\n    4: from datetime import datetime\n    5: from typing import TypeVar\n    6: \n    7: from sqlalchemy import select\n    8: from sqlalchemy.exc import IntegrityError, SQLAlchemyError\n    9: from sqlalchemy.orm import Session\n   10: \n   11: from app.core.errors import (\n   12:     AppError,\n   13:     AuthErrorCode,\n   14:     ErrorCode,\n   15:     IamErrorCode,\n   16:     ResidentErrorCode,\n   17: )\n   18: from app.core.time import utc_now\n   19: from app.domain.audit import AuditAction, AuditResourceType\n   20: from app.domain.iam import OrganizationScope, Principal, ScopeType\n   21: from app.domain.resident import (\n   22:     RESIDENT_BINDING_REVIEW,\n   23:     ResidentBindStatus,\n   24:     ResidentRelationStatus,\n   25:     ResidentRelationType,\n   26: )\n   27: from app.model.identity import Role, UserRole\n   28: from app.model.property import House\n   29: from app.model.resident import ResidentBindRequest, ResidentHouseRelation\n   30: from app.repository.identity import IdentityRepository\n   31: from app.repository.property import PropertyRepository\n   32: from app.repository.resident import ResidentBindingRepository\n   33: from app.service.audit import AuditService\n   34: from app.service.auth import AuthService\n   35: from app.service.rbac import RbacService\n   36: \n   37: T = TypeVar(\"T\")\n   38: _PENDING_UNIQUE = frozenset({\"uq_resident_bind_requests_pending_house\"})\n   39: _ACTIVE_UNIQUE = frozenset({\"uq_resident_house_relations_active_house\"})\n   40: _HOUSE_SCOPE_FK = frozenset(\n   41:     {\n   42:         \"fk_resident_bind_requests_house_scope_houses\",\n   43:         \"fk_resident_house_relations_house_scope_houses\",\n   44:     }\n   45: )\n   46: \n   47: \n   48: class ResidentBindingService:\n   49:     \"\"\"Own request/review transactions; repositories never commit.\"\"\"\n   50: \n   51:     def __init__(\n   52:         self,\n   53:         session: Session,\n   54:         repository: ResidentBindingRepository | None = None,\n   55:         property_repository: PropertyRepository | None = None,\n   56:         audit_service: AuditService | None = None,\n   57:         principal_loader: Callable[[int], Principal] | None = None,\n   58:     ) -> None:\n   59:         self._session = session\n   60:         self._repository = repository or ResidentBindingRepository(session)\n   61:         self._property_repository = property_repository or PropertyRepository(\n   62:             session\n   63:         )\n   64:         self._audit_service = audit_service or AuditService(session)\n   65:         self._principal_loader = principal_loader or AuthService(\n   66:             session,\n   67:             IdentityRepository(session),\n   68:         ).load_principal\n   69: \n   70:     def create_bind_request(\n   71:         self,\n   72:         *,\n   73:         actor: Principal,\n   74:         house_id: int,\n   75:         relation_type: str,\n   76:         request_id: str,\n   77:         claimed_tenant_id: int | None = None,\n   78:         claimed_property_id: int | None = None,\n   79:     ) -> ResidentBindRequest:\n   80:         self._require_positive_id(house_id, \"house_id\")\n   81:         validated_type = self._validate_relation_type(relation_type)\n   82:         self._validate_request_id(request_id)\n   83:         return self._execute(\n   84:             lambda: self._create_bind_request(\n   85:                 actor=actor,\n   86:                 house_id=house_id,\n   87:                 relation_type=validated_type,\n   88:                 request_id=request_id,\n   89:                 claimed_tenant_id=claimed_tenant_id,\n   90:                 claimed_property_id=claimed_property_id,\n   91:             )\n   92:         )\n   93: \n   94:     def list_my_bind_requests(\n   95:         self,\n   96:         *,\n   97:         actor: Principal,\n   98:         after_id: int = 0,\n   99:         limit: int = 50,\n  100:     ) -> tuple[ResidentBindRequest, ...]:\n  101:         self._require_active_actor(actor)\n  102:         return self._repository.list_bind_requests_for_user(\n  103:             user_id=actor.user_id,\n  104:             after_id=max(after_id, 0),\n  105:             limit=self._page_limit(limit),\n  106:         )\n  107: \n  108:     def list_pending_bind_requests(\n  109:         self,\n  110:         *,\n  111:         actor: Principal,\n  112:         tenant_id: int,\n  113:         property_id: int,\n  114:         after_id: int = 0,\n  115:         limit: int = 50,\n  116:     ) -> tuple[ResidentBindRequest, ...]:\n  117:         self._require_positive_id(tenant_id, \"tenant_id\")\n  118:         self._require_positive_id(property_id, \"property_id\")\n  119:         current = self._reload_actor(actor)\n  120:         property_record = self._property_repository.get_property(\n  121:             tenant_id=tenant_id,\n  122:             property_id=property_id,\n  123:         )\n  124:         if property_record is None:\n  125:             raise AppError(\n  126:                 code=IamErrorCode.FORBIDDEN,\n  127:                 message=\"Permission denied\",\n  128:                 status_code=403,\n  129:             )\n  130:         RbacService.require_permission(\n  131:             current,\n  132:             RESIDENT_BINDING_REVIEW,\n  133:             OrganizationScope(\n  134:                 ScopeType.PROPERTY,\n  135:                 tenant_id=property_record.tenant_id,\n  136:                 property_id=property_record.id,\n  137:             ),\n  138:         )\n  139:         return self._repository.list_pending_requests_for_property(\n  140:             tenant_id=property_record.tenant_id,\n  141:             property_id=property_record.id,\n  142:             after_id=max(after_id, 0),\n  143:             limit=self._page_limit(limit),\n  144:         )\n  145: \n  146:     def approve_bind_request(\n  147:         self,\n  148:         *,\n  149:         actor: Principal,\n  150:         request_id: int,\n  151:         http_request_id: str,\n  152:     ) -> tuple[ResidentBindRequest, ResidentHouseRelation]:\n  153:         self._require_positive_id(request_id, \"request_id\")\n  154:         self._validate_request_id(http_request_id)\n  155:         return self._execute(\n  156:             lambda: self._review_approve(\n  157:                 actor=actor,\n  158:                 request_id=request_id,\n  159:                 http_request_id=http_request_id,\n  160:             )\n  161:         )\n  162: \n  163:     def reject_bind_request(\n  164:         self,\n  165:         *,\n  166:         actor: Principal,\n  167:         request_id: int,\n  168:         reason: str,\n  169:         http_request_id: str,\n  170:     ) -> ResidentBindRequest:\n  171:         self._require_positive_id(request_id, \"request_id\")\n  172:         self._validate_request_id(http_request_id)\n  173:         normalized_reason = self._required_reason(reason)\n  174:         return self._execute(\n  175:             lambda: self._review_reject(\n  176:                 actor=actor,\n  177:                 request_id=request_id,\n  178:                 reason=normalized_reason,\n  179:                 http_request_id=http_request_id,\n  180:             )\n  181:         )\n  182: \n  183:     def list_my_houses(\n  184:         self,\n  185:         *,\n  186:         actor: Principal,\n  187:         after_id: int = 0,\n  188:         limit: int = 50,\n  189:         now: datetime | None = None,\n  190:     ) -> tuple[tuple[ResidentHouseRelation, House], ...]:\n  191:         self._require_active_actor(actor)\n  192:         current_time = now or utc_now()\n  193:         return self._repository.list_active_relations_for_user(\n  194:             user_id=actor.user_id,\n  195:             now=current_time,\n  196:             after_id=max(after_id, 0),\n  197:             limit=self._page_limit(limit),\n  198:         )\n  199: \n  200:     def get_my_house(\n  201:         self,\n  202:         *,\n  203:         actor: Principal,\n  204:         house_id: int,\n  205:         now: datetime | None = None,\n  206:     ) -> House:\n  207:         self._require_active_actor(actor)\n  208:         self._require_positive_id(house_id, \"house_id\")\n  209:         house = self._repository.get_active_house_for_user(\n  210:             user_id=actor.user_id,\n  211:             house_id=house_id,\n  212:             now=now or utc_now(),\n  213:         )\n  214:         if house is None:\n  215:             raise AppError(\n  216:                 code=ResidentErrorCode.HOUSE_NOT_FOUND,\n  217:                 message=\"House was not found\",\n  218:                 status_code=404,\n  219:             )\n  220:         return house\n  221: \n  222:     def end_relation(\n  223:         self,\n  224:         relation: ResidentHouseRelation,\n  225:         *,\n  226:         ended_at: datetime | None = None,\n  227:         status: ResidentRelationStatus = ResidentRelationStatus.ENDED,\n  228:     ) -> ResidentHouseRelation:\n  229:         if relation.status != ResidentRelationStatus.ACTIVE.value:\n  230:             raise AppError(\n  231:                 code=ResidentErrorCode.CONFLICT,\n  232:                 message=\"Relation is not active\",\n  233:                 status_code=409,\n  234:             )\n  235:         return self._repository.end_relation(\n  236:             relation,\n  237:             ended_at=ended_at or utc_now(),\n  238:             status=status.value,\n  239:         )\n  240: \n  241:     def _create_bind_request(\n  242:         self,\n  243:         *,\n  244:         actor: Principal,\n  245:         house_id: int,\n  246:         relation_type: ResidentRelationType,\n  247:         request_id: str,\n  248:         claimed_tenant_id: int | None,\n  249:         claimed_property_id: int | None,\n  250:     ) -> ResidentBindRequest:\n  251:         current = self._reload_actor(actor)\n  252:         house = self._require_registered_house(house_id)\n  253:         self._reject_claimed_scope_mismatch(\n  254:             house,\n  255:             claimed_tenant_id=claimed_tenant_id,\n  256:             claimed_property_id=claimed_property_id,\n  257:         )\n  258:         if house.status != \"ACTIVE\":\n  259:             raise AppError(\n  260:                 code=ResidentErrorCode.HOUSE_NOT_AVAILABLE,\n  261:                 message=\"House is not available for binding\",\n  262:                 status_code=409,\n  263:             )\n  264:         # Self-application is an applicant policy, not a target-property grant.\n  265:         self._require_active_actor(current)\n  2