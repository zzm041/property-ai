D:\\property-ai\nexec\n\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$OutputEncoding=[Console]::OutputEncoding=[Text.UTF8Encoding]::new(); Get-Content -Raw -Encoding UTF8 reports/auth-identity-ai-001/release-pack-inventory.json; Get-Content -Raw -Encoding UTF8 reports/auth-identity-ai-001/self-host-recommendation.md; Get-Content -Raw -Encoding UTF8 reports/auth-identity-ai-001/software-test-results.json' in D:\\property-ai\n succeeded in 0ms:\n�޷��������͡�������ģʽ��֧�ֺ������͡�\n����λ�� ��:2 �ַ�: 17\n+ ... putEncoding=[Console]::OutputEncoding=[Text.UTF8Encoding]::new(); Get ...\n+                 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n    + CategoryInfo          : InvalidOperation: (:) []��RuntimeException\n    + FullyQualifiedErrorId : CannotCreateTypeConstrainedLanguage\n \n\"\"\"Build a local miniprogram release tree that excludes development login files.\n\nDoes not read, copy, stage, overwrite, or restore miniprogram/project.config.json.\nDoes not upload, submit, or publish.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport shutil\nfrom pathlib import Path\n\nREPO = Path(__file__).resolve().parents[2]\nSOURCE = REPO / \"miniprogram\"\nDEFAULT_OUT = REPO / \"reports\" / \"auth-identity-ai-001\" / \"release-pack\"\nSKIP_NAMES = {\n    \"env.local.js\",\n    \"project.config.json\",\n    \"project.private.config.json\",\n    \"node_modules\",\n    \"miniprogram_npm\",\n}\nDEV_LOGIN_MARKERS = (\"pages/dev-login\", \"dev-login\")\n\n\ndef _should_skip(path: Path) -> bool:\n    relative = path.relative_to(SOURCE).as_posix()\n    if path.name in SKIP_NAMES:\n        return True\n    if relative.startswith(\"pages/dev-login/\") or relative == \"pages/dev-login\":\n        return True\n    return False\n\n\ndef pack_release(destination: Path) -> dict[str, object]:\n    if not SOURCE.is_dir():\n        raise FileNotFoundError(SOURCE)\n    if destination.exists():\n        shutil.rmtree(destination)\n    destination.mkdir(parents=True)\n    copied: list[str] = []\n    for path in SOURCE.rglob(\"*\"):\n        if _should_skip(path):\n            continue\n        relative = path.relative_to(SOURCE)\n        target = destination / relative\n        if path.is_dir():\n            target.mkdir(parents=True, exist_ok=True)\n            continue\n        target.parent.mkdir(parents=True, exist_ok=True)\n        shutil.copy2(path, target)\n        copied.append(relative.as_posix())\n\n    app_json_path = destination / \"app.json\"\n    app_json = json.loads(app_json_path.read_text(encoding=\"utf-8\"))\n    pages = [page for page in app_json.get(\"pages\", []) if page != \"pages/dev-login/dev-login\"]\n    if \"pages/dev-login/dev-login\" in app_json.get(\"pages\", []):\n        app_json[\"pages\"] = pages\n    app_json_path.write_text(\n        json.dumps(app_json, ensure_ascii=False, indent=2) + \"\\n\",\n        encoding=\"utf-8\",\n    )\n\n    project_config = {\n        \"miniprogramRoot\": \"./\",\n        \"projectname\": \"property-ai-release-check\",\n        \"appid\": \"wx0000000000000000\",\n        \"compileType\": \"miniprogram\",\n        \"setting\": {\n            \"es6\": True,\n            \"minified\": True,\n            \"postcss\": False,\n            \"enhance\": False,\n        },\n        \"packOptions\": {\"ignore\": [{\"type\": \"folder\", \"value\": \"pages/dev-login\"}]},\n        \"editorSetting\": {},\n    }\n    (destination / \"project.config.json\").write_text(\n        json.dumps(project_config, ensure_ascii=False, indent=2) + \"\\n\",\n        encoding=\"utf-8\",\n    )\n    copied.append(\"project.config.json\")\n\n    leftover = [\n        path.relative_to(destination).as_posix()\n        for path in destination.rglob(\"*\")\n        if path.is_file()\n        and any(marker in path.relative_to(destination).as_posix() for marker in DEV_LOGIN_MARKERS)\n    ]\n    login_wxml = (destination / \"pages\" / \"login\" / \"login.wxml\").read_text(encoding=\"utf-8\")\n    env_js = (destination / \"config\" / \"env.js\").read_text(encoding=\"utf-8\")\n    inventory = {\n        \"source\": str(SOURCE),\n        \"destination\": str(destination),\n        \"file_count\": len(copied),\n        \"files\": sorted(copied),\n        \"app_json_pages\": pages,\n        \"dev_login_files\": leftover,\n        \"ordinary_login_has_seed_buttons\": any(\n            label in login_wxml for label in (\"��ס����¼\", \"����ҵ��¼\", \"��Ա����¼\")\n        ),\n        \"env_local_copied\": (destination / \"config\" / \"env.local.js\").exists(),\n        \"user_project_config_copied\": False,\n        \"test_env_note_present\": \"���Ի���\" in env_js,\n        \"dev_login_page_registered\": \"pages/dev-login/dev-login\" in pages,\n    }\n    if leftover or inventory[\"ordinary_login_has_seed_buttons\"] or inventory[\"dev_login_page_registered\"]:\n        raise RuntimeError(f\"release pack still contains development login: {inventory}\")\n    (destination.parent / \"release-pack-inventory.json\").write_text(\n        json.dumps(inventory, ensure_ascii=False, indent=2) + \"\\n\",\n        encoding=\"utf-8\",\n    )\n    return inventory\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--out\", default=str(DEFAULT_OUT))\n    args = parser.parse_args()\n    inventory = pack_release(Path(args.out))\n    print(f\"release_pack={inventory['destination']}\")\n    print(f\"file_count={inventory['file_count']}\")\n    print(\"dev_login_files=0\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n\n\"\"\"Release-pack isolation checks. Does not touch the operator project.config.json.\"\"\"\n\nimport importlib.util\nfrom pathlib import Path\n\nREPO = Path(__file__).resolve().parents[3]\nPACK = REPO / \"scripts\" / \"ops\" / \"pack_miniprogram_release.py\"\nUSER_CONFIG = REPO / \"miniprogram\" / \"project.config.json\"\n\n\ndef test_release_pack_