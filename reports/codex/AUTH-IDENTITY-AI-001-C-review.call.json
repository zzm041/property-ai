ccess_envelope\\n   18: from app.service.analysis import AnalysisService\\n   19: \\n   20: router = APIRouter(prefix=\\\"/supervisor\\\", tags=[\\\"supervisor-ai\\\"])\\n   21: \\n   22: \\n   23: def get_analysis_service(\\n   24:     session: Annotated[Session, Depends(get_db_session)],\\n   25: ) -> AnalysisService:\\n   26:     return AnalysisService(session)\\n   27: \\n   28: \\n   29: def analysis_data(record) -> WorkOrderAnalysisData:\\n   30:     return WorkOrderAnalysisData(\\n   31:         id=record.id,\\n   32:         work_order_id=record.work_order_id,\\n   33:         analysis_version=record.analysis_version,\\n   34:         status=record.status,\\n   35:         category=record.category,\\n   36:         subcategory=record.subcategory,\\n   37:         severity=record.severity,\\n   38:         priority=record.priority,\\n   39:         summary=record.summary,\\n   40:         risk=record.risk,\\n   41:         required_role=record.required_role,\\n   42:         required_skill=record.required_skill,\\n   43:         confidence=record.confidence,\\n   44:         error_code=record.error_code,\\n   45:     )\\n   46: \\n   47: \\n   48: @router.post(\\\"/work-orders/{work_order_id}/analyze\\\")\\n   49: def analyze_work_order(\\n   50:     work_order_id: int,\\n   51:     request: Request,\\n   52:     actor: Annotated[Principal, Depends(get_current_principal)],\\n   53:     service: Annotated[AnalysisService, Depends(get_analysis_service)],\\n   54: ) -> dict[str, object]:\\n   55:     record = service.analyze_work_order(\\n   56:         work_order_id=work_order_id,\\n   57:         request_id=request_id_for(request),\\n   58:         actor=actor,\\n   59:     )\\n   60:     work_order = service._work_orders.get_work_order(work_order_id)\\n   61:     return success_envelope(\\n   62:         request,\\n   63:         {\\n   64:             \\\"analysis\\\": None if record is None else analysis_data(record).model_dump(mode=\\\"json\\\"),\\n   65:             \\\"work_order\\\": None if work_order is None else work_order_data(work_order).model_dump(mode=\\\"json\\\"),\\n   66:         },\\n   67:     )\\n   68: \\n   69: \\n   70: @router.get(\\\"/work-orders/{work_order_id}/analysis\\\")\\n   71: def get_work_order_analysis(\\n   72:     work_order_id: int,\\n   73:     request: Request,\\n   74:     actor: Annotated[Principal, Depends(get_current_principal)],\\n   75:     service: Annotated[AnalysisService, Depends(get_analysis_service)],\\n   76: ) -> dict[str, object]:\\n   77:     record = service.get_analysis(actor=actor, work_order_id=work_order_id)\\n   78:     return success_envelope(\\n   79:         request,\\n   80:         None if record is None else analysis_data(record).model_dump(mode=\\\"json\\\"),\\n   81:     )\\n   82: \\n   83: \\n   84: @router.get(\\\"/work-orders/{work_order_id}/recommendations\\\")\\n   85: def list_dispatch_recommendations(\\n   86:     work_order_id: int,\\n   87:     request: Request,\\n   88:     actor: Annotated[Principal, Depends(get_current_principal)],\\n   89:     service: Annotated[AnalysisService, Depends(get_analysis_service)],\\n   90: ) -> dict[str, object]:\\n   91:     items = [\\n   92:         DispatchRecommendationData(\\n   93:             employee_id=item.employee_id,\\n   94:             score=item.score,\\n   95:             rank_no=item.rank_no,\\n   96:             eligible=bool(item.eligible),\\n   97:             reason_codes=list(item.reason_codes or ()),\\n   98:             filter_reason=item.filter_reason,\\n   99:         )\\n  100:         for item in service.list_recommendations(actor=actor, work_order_id=work_order_id)\\n  101:     ]\\n  102:     return success_envelope(\\n  103:         request,\\n  104:         DispatchRecommendationListData(items=items, next_cursor=None).model_dump(mode=\\\"json\\\"),\\n  105:     )\\n\\n succeeded in 0ms:\\n  500:         *,\\n  501:         provider_type: ProviderType,\\n  502:         operation: str,\\n  503:         status: AiCallStatus,\\n  504:         started_at: datetime,\\n  505:         latency_ms: int,\\n  506:         request_id: str,\\n  507:         attempt: int,\\n  508:         model_version: str,\\n  509:         error_code: str | None = None,\\n  510:     ) -> None:\\n  511:         finished_at = started_at + timedelta(milliseconds=max(latency_ms, 0))\\n  512:         with begin_owned_transaction(self._session):\\n  513:             self._ai.add_call_log(\\n  514:                 AiCallLog(\\n  515:                     tenant_id=snapshot.tenant_id,\\n  516:                     property_id=snapshot.property_id,\\n  517:                     work_order_id=snapshot.work_order_id,\\n  518:                     request_id=request_id,\\n  519:                     provider_type=provider_type.value,\\n  520:                     operation=operation,\\n  521:                     biz_type=\\\"WORK_ORDER_ANALYSIS\\\",\\n  522:                     prompt_version=WORK_ORDER_ANALYSIS_PROMPT_VERSION,\\n  523:                     model_version=model_version,\\n  524:                     status=status.value,\\n  525:                     started_at=started_at,\\n  526:                     finished_at=finished_at,\\n  527:                     latency_ms=latency_ms,\\n  528:                     attempt=attempt,\\n  529:                     error_code=error_code,\\n  530:                     token_usage=None,\\n  531:                     input_hash=snapshot.input_hash,\\n  532:                 )\\n  533:             )\\n  534: \\n  535:     def _apply(\\n  536:         self,\\n  537:         *,\\n  538:         snapshot: AnalysisSnapshot,\\n  539:         bundle: ProviderBundle,\\n  540:         request_id: str,\\n  541:         attempt: int,\\n  542:     ) -> WorkOrderAnalysis | None:\\n  543:         del attempt\\n  544:         try:\\n  545:             with begin_owned_transaction(self._session):\\n  546:                 record = self._work_orders.get_work_order_for_update(snapshot.work_order_id)\\n  547:                 analysis = self._ai.get_current_analysis_for_update(snapshot.work_order_id)\\n  548:                 if record is None or analysis is None:\\n  549:                     return None\\n  550:                 if analysis.id != snapshot.analysis_id:\\n  551:                     return analysis\\n  552:                 if analysis.status != AnalysisStatus.PROCESSING.value:\\n  553:                     return analysis\\n  554:                 content = self._work_orders.get_content(record.id)\\n  555:                 if content is not None and bundle.asr_text:\\n  556:                     content.asr_text = bundle.asr_text\\n  557:                 stale = record.status != WorkOrderStatus.PENDING_ANALYSIS.value\\n  558:                 mapped, mapped_error = self._validate_payload(bundle.llm_payload)\\n  559:                 if stale:\\n  560:                     analysis.status = AnalysisStatus.STALE.value\\n  561:                     analysis.error_code = AiErrorCode.STALE_RESULT\\n  562:                     self._append_failure_audit(\\n  563:                         record,\\n  564:                         analysis,\\n  565:                         request_id,\\n  566:                         AiErrorCode.STALE_RESULT,\\n  567:                     )\\n  568:                     return analysis\\n  569:                 if mapped is None:\\n  570:                     analysis.status = AnalysisStatus.FAILED.value\\n  571:                     analysis.error_code = mapped_error or bundle.error_code or AiErrorCode.PROVIDER_FAILED\\n  572:                     self._append_failure_audit(\\n  573:                         record,\\n  574:                         analysis,\\n  575:                         request_id,\\n  576:                         analysis.error_code,\\n  577:                     )\\n  578:                     return analysis\\n  579:                 self._fill_analysis(analysis, mapped)\\n  580:                 if mapped.low_confidence:\\n  581:                     analysis.status = AnalysisStatus.LOW_CONFIDENCE.value\\n  582:                     analysis.error_code = AiErrorCode.LOW_CONFIDENCE\\n  583:                 else:\\n  584:                     analysis.status = AnalysisStatus.COMPLETED.value\\n  585:                     analysis.error_code = None\\n  586:                     record.category = mapped.category.value\\n  587:                     record.severity = mapped.severity.value\\n  588:                     record.priority = mapped.priority.value\\n  589:                     self._transition_analyzed(record, request_id)\\n  590:                 self._write_recommendations(record, analysis, mapped, snapshot.building_id)\\n  591:                 self._append_success_audit(record, analysis, request_id, mapped)\\n  592:                 if analysis.status == AnalysisStatus.COMPLETED.value:\\n  593:                     from app.service.incident import IncidentService\\n  594: \\n  595:                     IncidentService(self._session, settings=self._settings).aggregate_locked(\\n  596:                         record,\\n  597:                         request_id=request_id,\\n  598:                     )\\n  599:                 return analysis\\n  600:         except AppError:\\n  601:             raise\\n  602:         except SQLAlchemyError as exc:\\n  603:             raise AppError(\\n  604:                 code=ErrorCode.INTERNAL_ERROR,\\n  605:                 message=\\\"AI analysis could not be stored\\\",\\n  606:                 status_code=500,\\n  607:             ) from exc\\n  608: \\n  609:     def _validate_payload(\\n  610:         self,\\n  611:         payload: Mapping[str, object] | None,\\n  612:     ) -> tuple[MappedAnalysis | None, str | None]:\\n  613:         if payload is None:\\n  614:             return None, None\\n  615:         try:\\n  616:             output = WorkOrderAnalysisOutput.model_validate(payload)\\n  617:             mapped = map_analysis_output(\\n  618:                 output,\\n  619:                 threshold=self._settings.ai_confidence_threshold\\n  620:                 or DEFAULT_CONFIDENCE_THRESHOLD,\\n  621:             )\\n  622:         except (ValidationError, ValueError):\\n  623:             return None, AiErrorCode.INVALID_OUTPUT\\n  624:         return mapped, None\\n  625: \\n  626:     @staticmethod\\n  627:     def _fill_analysis(analysis: WorkOrderAnalysis, mapped: MappedAnalysis) -> None:\\n  628:         analysis.category = mapped.category.value\\n  629:         analysis.subcategory = mapped.subcategory\\n  630:         analysis.severity = mapped.severity.value\\n  631:         analysis.priority = mapped.priority.value\\n  632:         analysis.summary = mapped.summary\\n  633:         analysis.risk = mapped.risk.value\\n  634:         analysis.required_role = mapped.required_role\\n  635:         analysis.required_skill = mapped.required_skill\\n  636:         analysis.confidence = Decimal(str(mapped.confidence))\\n  637: \\n  638:     def _transition_analyzed(self, record: WorkOrder, request_id: str) -> None:\\n  639:         from_status = WorkOrderStatus(record.status)\\n  640:         to_status = WorkOrderStatus.PENDING_ASSIGNMENT\\n  641:         require_legal_transition(\\n  642:             from_status=from_status,\\n  643:             to_status=to_status,\\n  644:             event=WorkOrderEvent.ANALYZE,\\n  645:         )\\n  646:         record.status = to_status.value\\n  647:         record.version += 1\\n  648:         self._work_orders.add_log(\\n  649:             WorkOrderLog(\\n  650:                 tenant_id=record.tenant_id,\\n  651:                 property_id=record.property_id,\\n  652:                 work_order_id=record.id,\\n  653:                 actor_user_id=None,\\n  654:                 actor_type=WorkOrderActorType.SYSTEM.value,\\n  655:                 from_status=from_status.value,\\n  656:                 to_status=to_status.value,\\n  657:                 process_reason=record.process_reason,\\n  658:                 event_code=WorkOrderEvent.ANALYZE.value,\\n  659:                 request_id=request_id,\\n  660:                 payload_json={\\\"event_code\\\": WorkOrderEvent.ANALYZE.value, \\\"reason_code\\\": \\\"AI_ANALYSIS\\\"},\\n  661:             )\\n  662:         )\\n  663: \\n  664:     def _write_recommendations(\\n  665:         self,\\n  666:         record: WorkOrder,\\n  667:         analysis: WorkOrderAnalysis,\\n  668:         mapped: MappedAnalysis,\\n  669:         building_id: int | None,\\n  670:     ) -> None:\\n  671:         self._ai.delete_recommendations(analysis.id)\\n  672:         now = self._clock()\\n  673:         property_record = self._work_orders.get_property(record.property_id)\\n  674:         if property_record is None:\\n  675:             return\\n  676:         business_date = current_business_date(property_record.timezone, clock=self._clock)\\n  677:         employees = self._ai.list_property_employees(\\n  678:             tenant_id=record.tenant_id,\\n  679:             property_id=record.property_id,\\n  680:         )\\n  681:         candidates: list[DispatchCandidate] = []\\n  682:         ineligible: list[tuple[DispatchCandidate, FilterReason]] = []\\n  683:         for employee in employees:\\n  684:             assignment = self._ai.get_effective_property(\\n  685:                 employee_id=employee.id,\\n  686:                 property_id=record.property_id,\\n  687:                 now=now,\\n  688:             )\\n  689:             daily = self._ai.get_daily_status(\\n  690:                 employee_id=employee.id,\\n  691:                 property_id=record.property_id,\\n  692:                 business_date=business_date,\\n  693:             )\\n  694:             roles = self._ai.list_employee_role_codes(employee.user_id)\\n  695:             candidate = DispatchCandidate(\\n  696:                 employee_id=employee.id,\\n  697:                 duty_codes=self._ai.list_employee_duties(employee.id),\\n  698:                 skill_codes=self._ai.list_employee_skills(employee.id),\\n  699:                 current_load=0 if daily is None else daily.current_load,\\n  700:                 max_capacity=employee.max_capacity,\\n  701:                 on_duty=daily is not None\\n  702:                 and daily.on_duty == AttendanceOnDuty.ON_DUTY.value,\\n  703:                 employee_active=employee.status == EmployeeStatus.ACTIVE.value,\\n  704:                 property_effective=assignment is not None,\\n  705:                 has_staff_role=bool(roles & _STAFF_ROLES),\\n  706:                 same_building_history=self._ai.count_same_building_history(\\n  707:                     employee_id=employee.id,\\n  708:                     building_id=building_id,\\n  709:                     tenant_id=record.tenant_id,\\n  710:                     property_id=record.property_id,\\n  711:                 ),\\n  712:                 primary_incident_handler=False,\\n  713:             )\\n  714:             reason = hard_filter_candidate(\\n  715:                 candidate,\\n  716:                 required_skill=mapped.required_skill,\\n  717:                 required_duty=mapped.required_duty,\\n  718:             )\\n  719:             if reason is None:\\n  720:                 candidates.append(candidate)\\n  721:             else:\\n  722:                 ineligible.append((candidate, reason))\\n  723:         ranked = rank_candidates(\\n  724:             tuple(candidates),\\n  725:             required_skill=mapped.required_skill,\\n  726:             required_duty=mapped.required_duty,\\n  727:         )\\n  728:         rank_no = 1\\n  729:         for candidate, score, reasons in ranked:\\n  730:             self._ai.add_recommendation(\\n  731:                 DispatchRecommendation(\\n  732:                     tenant_id=record.tenant_id,\\n  733:                     p