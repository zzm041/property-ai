103:                 self._session.flush()\n 104:             challenge = SmsChallenge(\n 105:                 phone_e164=phone_e164,\n 106:                 purpose=purpose,\n 107:                 code_hash=keyed_hash(code, secret=secret),\n 108:                 expires_at=expires,\n 109:                 attempts=0,\n 110:                 max_attempts=self._settings.sms_otp_max_attempts,\n 111:             )\n 112:             self._repository.add_challenge(challenge)\n 113: \n 114:         try:\n 115:             run_owned_transaction(self._session, _persist)\n 116:         except SQLAlchemyError as exc:\n 117:             raise AppError(\n 118:                 code=ErrorCode.INTERNAL_ERROR,\n 119:                 message=\"SMS challenge could not be stored\",\n 120:                 status_code=500,\n 121:             ) from exc\n 122:         try:\n 123:             sent = self._sms.send(phone_e164=phone_e164, purpose=purpose, code=code)\n 124:         except Exception as exc:\n 125:             raise AppError(\n 126:                 code=AuthErrorCode.SMS_PROVIDER_DOWN,\n 127:                 message=\"SMS provider is unavailable\",\n 128:                 status_code=503,\n 129:             ) from exc\n 130:         return SmsSendData(\n 131:             delivery_channel=sent.delivery_channel,\n 132:             provider_mode=sent.provider_mode,\n 133:             masked_phone=mask_phone(phone_e164),\n 134:             expires_in=self._settings.sms_otp_ttl_seconds,\n 135:         )\n 136: \n 137:     def login_sms(self, *, phone: str, code: str, request_id: str) -> IssuedSession:\n 138:         phone_e164 = self._require_phone(phone)\n 139:         self._hit_login_limit(phone_e164)\n 140:         user_id_holder: dict[str, int] = {}\n 141:         refresh_holder: dict[str, str] = {}\n 142: \n 143:         otp_status = {\"value\": \"ok\"}\n 144: \n 145:         def _persist() -> None:\n 146:             otp_status[\"value\"] = self._apply_otp(phone_e164, purpose=\"login\", code=code)\n 147:             if otp_status[\"value\"] != \"ok\":\n 148:                 return\n 149:             phone_row = self._repository.get_active_phone(phone_e164)\n 150:             if phone_row is None:\n 151:                 user = self._repository.add_user(\n 152:                     User(status=\"ACTIVE\", display_name=mask_phone(phone_e164))\n 153:                 )\n 154:                 self._repository.add_phone(\n 155:                     UserPhone(\n 156:                         user_id=user.id,\n 157:                         phone_e164=phone_e164,\n 158:                         status=\"ACTIVE\",\n 159:                         verified_at=self._clock(),\n 160:                     )\n 161:                 )\n 162:                 user_id = user.id\n 163:             else:\n 164:                 user = self._identity.get_user(phone_row.user_id)\n 165:                 if user is None or user.status != \"ACTIVE\":\n 166:                     raise AppError(\n 167:                         code=AuthErrorCode.USER_DISABLED,\n 168:                         message=\"User is not active\",\n 169:                         status_code=401,\n 170:                     )\n 171:                 user_id = user.id\n 172:             issued = self._issue_session(user_id=user_id, auth_method=\"sms\")\n 173:             self._audit.append(\n 174:                 action=AuditAction.AUTH_SMS_TOKEN_ISSUED,\n 175:                 resource_type=AuditResourceType.USER,\n 176:                 actor_user_id=user_id,\n 177:                 resource_id=user_id,\n 178:                 request_id=request_id,\n 179:                 scope_type=ScopeType.SYSTEM,\n 180:                 details={\"auth_method\": \"sms\", \"token_type\": \"access\"},\n 181:             )\n 182:             user_id_holder[\"user_id\"] = issued.user_id\n 183:             refresh_holder[\"refresh\"] = issued.refresh_token\n 184:             refresh_holder[\"access\"] = issued.access_token\n 185:             user_id_holder[\"session_id\"] = issued.session_id\n 186: \n 187:         try:\n 188:             run_owned_transaction(self._session, _persist)\n 189:         except AppError:\n 190:             raise\n 191:         except IntegrityError as exc:\n 192:             raise AppError(\n 193:                 code=AuthErrorCode.INVALID_PHONE,\n 194:                 message=\"Phone number is already registered\",\n 195:                 status_code=409,\n 196:             ) from exc\n 197:         except SQLAlchemyError as exc:\n 198:             raise AppError(\n 199:                 code=ErrorCode.INTERNAL_ERROR,\n 200:                 message=\"SMS login could not be completed\",\n 201:                 status_code=500,\n 202:             ) from exc\n 203:         self._raise_otp(otp_status[\"value\"])\n 204:         return IssuedSession(\n 205:             access_token=refresh_holder[\"access\"],\n 206:             refresh_token=refresh_holder[\"refresh\"],\n 207:             token_type=\"bearer\",\n 208:             expires_in=self._settings.jwt_access_token_ttl_seconds,\n 209:             auth_method=\"sms\",\n 210:             user_id=user_id_holder[\"user_id\"],\n 211:             session_id=user_id_holder[\"session_id\"],\n 212:         )\n 213: \n 214:     def login_password(\n 215:         self, *, phone: str, password: str, request_id: str\n 216:     ) -> IssuedSession:\n 217:         phone_e164 = self._require_phone(phone)\n 218:         self._hit_login_limit(phone_e164)\n 219:         issued_box: list[IssuedSession] = []\n 220: \n 221:         def _persist() -> None:\n 222:             phone_row = self._repository.get_active_phone(phone_e164)\n 223:             credential = None\n 224:             if phone_row is not None:\n 225:                 credential = self._repository.get_password(phone_row.user_id)\n 226:             if (\n 227:                 phone_row is None\n 228:                 or credential is None\n 229:                 or not verify_password(credential.password_hash, password)\n 230:             ):\n 231:                 raise AppError(\n 232:                     code=AuthErrorCode.INVALID_PASSWORD,\n 233:                     message=\"Phone or password is incorrect\",\n 234:                     status_code=401,\n 235:                 )\n 236:             user = self._identity.get_user(phone_row.user_id)\n 237:             if user is None or user.status != \"ACTIVE\":\n 238:                 raise AppError(\n 239:                     code=AuthErrorCode.USER_DISABLED,\n 240:                     message=\"User is not active\",\n 241:                     status_code=401,\n 242:                 )\n 243:             issued = self._issue_session(user_id=user.id, auth_method=\"password\")\n 244:             self._audit.append(\n 245:                 action=AuditAction.AUTH_PASSWORD_TOKEN_ISSUED,\n 246:                 resource_type=AuditResourceType.USER,\n 247:                 actor_user_id=user.id,\n 248:                 resource_id=user.id,\n 249:                 request_id=request_id,\n 250:                 scope_type=ScopeType.SYSTEM,\n 251:                 details={\"auth_method\": \"password\", \"token_type\": \"access\"},\n 252:             )\n 253:             issued_box.append(issued)\n 254: \n 255:         try:\n 256:             run_owned_transaction(self._session, _persist)\n 257:         except AppError:\n 258:             raise\n 259:         except SQLAlchemyError as exc:\n 260:             raise AppError(\n 261:                 code=ErrorCode.INTERNAL_ERROR,\n 262:                 message=\"Password login could not be completed\",\n 263:                 status_code=500,\n 264:             ) from exc\n 265:         return issued_box[0]\n 266: \n 267:     def change_password(\n 268:         self,\n 269:         *,\n 270:         user_id: int,\n 271:         old_password: str,\n 272:         new_password: str,\n 273:         request_id: str,\n 274:     ) -> IssuedSession:\n 275:         issued_box: list[IssuedSession] = []\n 276: \n 277:         def _persist() -> None:\n 278:             credential = self._repository.get_password(user_id)\n 279:             if credential is None or not verify_password(\n 280:                 credential.password_hash, old_password\n 281:             ):\n 282:                 raise AppError(\n 283:                     code=AuthErrorCode.INVALID_PASSWORD,\n 284:                     message=\"Current password is incorrect\",\n 285:                     status_code=401,\n 286:                 )\n 287:             credential.password_hash = hash_password(new_password)\n 288:             credential.password_algo = \"argon2id\"\n 289:             self._revoke_sessions(user_id, reason=\"PASSWORD_CHANGE\", request_id=request_id)\n 290:             issued = self._issue_session(user_id=user_id, auth_method=\"password\")\n 291:             self._audit.append(\n 292:                 action=AuditAction.AUTH_PASSWORD_CHANGED,\n 293:                 resource_type=AuditResourceType.USER,\n 294:                 actor_user_id=user_id,\n 295:                 resource_id=user_id,\n 296:                 request_id=request_id,\n 297:                 scope_type=ScopeType.SYSTEM,\n 298:                 details={\"auth_method\": \"password\"},\n 299:             )\n 300:             issued_box.append(issued)\n 301: \n 302:         run_owned_transaction(self._session, _persist)\n 303:         return issued_box[0]\n 304: \n 305:     def reset_password(\n 306:         self, *, phone: str, code: str, new_password: str, request_id: str\n 307:     ) -> IssuedSession:\n 308:         phone_e164 = self._require_phone(phone)\n 309:         otp_status = {\"value\": \"ok\"}\n 310:         issued_box: list[IssuedSession] = []\n 311: \n 312:         def _persist() -> None:\n 313:             otp_status[\"value\"] = self._apply_otp(phone_e164, purpose=\"reset\", code=code)\n 314:             if otp_status[\"value\"] != \"ok\":\n 315:                 return\n 316:             phone_row = self._repository.get_active_phone(phone_e164)\n 317:             if phone_row is None:\n 318:                 raise AppError(\n 319:                     code=AuthErrorCode.INVALID_CODE,\n 320:                     message=\"Verification code is invalid or expired\",\n 321:                     status_code=401,\n 322:                 )\n 323:             credential = self._repository.get_password(phone_row.user_id)\n 324:             hashed = hash_password(new_password)\n 325:             if credential is None:\n 326:                 self._repository.add_password(\n 327:                     UserPassword(\n 328:                         user_id=phone_row.user_id,\n 329:                         password_hash=hashed,\n 330:                         password_algo=\"argon2id\",\n 331:                     )\n 332:                 )\n 333:             else:\n 334:                 credential.password_hash = hashed\n 335:                 credential.password_algo = \"argon2id\"\n 336:             self._revoke_sessions(\n 337:                 phone_row.user_id, reason=\"PASSWORD_RESET\", request_id=request_id\n 338:             )\n 339:             issued = self._issue_session(\n 340:                 user_id=phone_row.user_id, auth_method=\"password\"\n 341:             )\n 342:             self._audit.append(\n 343:                 action=AuditAction.AUTH_PASSWORD_RESET,\n 344:                 resource_type=AuditResourceType.USER,\n 345:                 actor_user_id=phone_row.user_id,\n 346:                 resource_id=phone_row.user_id,\n 347:                 request_id=request_id,\n 348:                 scope_type=ScopeType.SYSTEM,\n 349:                 details={\"auth_method\": \"password\"},\n 350:             )\n 351:             issued_box.append(issued)\n 352: \n 353:         run_owned_transaction(self._session, _persist)\n 354:         self._raise_otp(otp_status[\"value\"])\n 355:         return issued_box[0]\n 356: \n 357:     def refresh(self, *, refresh_token: str, request_id: str) -> IssuedSession:\n 358:         issued_box: list[IssuedSession] = []\n 359:         secret = self._settings.app_secret_key.get_secret_value()\n 360:         token_hash = keyed_hash(refresh_token, secret=secret)\n 361: \n 362:         def _persist() -> None:\n 363:             record = self._repository.get_session_by_refresh_hash(token_hash)\n 364:             now = self._clock()\n 365:             if (\n 366:                 record is None\n 367:                 or record.revoked_at is not None\n 368:                 or record.expires_at <= now\n 369:             ):\n 370:                 raise AppError(\n 371:                     code=AuthErrorCode.INVALID_TOKEN,\n 372:                     message=\"Refresh token is invalid\",\n 373:                     status_code=401,\n 374:                 )\n 375:             record.revoked_at = now\n 376:             issued = self._issue_session(\n 377:                 user_id=record.user_id, auth_method=record.auth_method\n 378:             )\n 379:             record.replaced_by_id = issued.session_id\n 380:             issued_box.append(issued)\n 381: \n 382:         try:\n 383:             run_owned_transaction(self._session, _persist)\n 384:         except AppError:\n 385:             raise\n 386:         except SQLAlchemyError as exc:\n 387:             raise AppError(\n 388:                 code=ErrorCode.INTERNAL_ERROR,\n 389:                 message=\"Token refresh failed\",\n 390:                 status_code=500,\n 391:             ) from exc\n 392:         return issued_box[0]\n 393: \n 394:     def logout(self, *, session_id: int | None, refresh_token: str | None, request_id: str) -> None:\n 395:         secret = self._settings.app_secret_key.get_secret_value()\n 396: \n 397:         def _persist() -> None:\n 398:             record = None\n 399:             if refresh_token:\n 400:                 record = self._repository.get_session_by_refresh_hash(\n 401:                     keyed_hash(refresh_token, secret=secret)\n 402:                 )\n 403:             elif session_id:\n 404:                 record = self._repository.get_session_for_update(session_id)\n 405:             if record is None or record.revoked_at is not None:\n 406:                 return\n 407:             record.revoked_at = self._clock()\n 408:             self._audit.append(\n 409:                 action=AuditAction.AUTH_SESSION_REVOKED,\n 410:                 resource_type=AuditResourceType.AUTH_SESSION,\n 411:                 actor_user_id=record.user_id,\n 412:                 resource_id=record.id,\n 413:                 request_id=request_id,\n 414:                 scope_type=ScopeType.SYSTEM,\n 415:                 details={\"auth_method\": record.auth_method, \"reason_code\": \"LOGOUT\"},\n 416:             )\n 417: \n 418:         run_owned_transaction(self._session, _persist)\n 419: \n 420:     def update_profile(self, *, user_id: int, display_name: str, request_id: str) -> User:\n 421:         name = display_name.strip()\n 422:         if not name:\n 423:             raise AppError(\n 424:                 code=AuthErrorCode.INVALID_USER,\n 425:                 message=\"display_name is required\",\n 426:                 status_code=422,\n 427:             )\n 428:         holder: list[User] = []\n 429: \n 430:         def _persist() -> None:\n 431:             user = self._identity.get_user(user_id)\n 432:             if user is None or user.status != \"ACTIVE\":\n 433:                 raise AppError(\n 434:                     code=AuthErrorCode.USER_DISABLED,\n 435:                     message=\"User is not active\",\n 436:                     status_code=401,\n 437:                 )\n 438:             user.display_name = name\n 439:             self._audit.append(\n 440:                 action=AuditAction.AUTH_PROFILE_UPDATED,\n 441:                 resource_type=AuditResourceType.USER,\n 442:                 actor_user_id=user.id,\n 443:                 resource_id=user.id,\n 444:                 request_id=request_id,\n 445:                 scope_type=ScopeType.SYSTEM,\n 446:                 details={},\n 447:             )\n 448:             holder.append(user)\n 449: \n 450:         run_owned_transaction(self._session, _persist)\n 451:         return holder[0]\n 452: \n 453:     def require_active_session(self, session_id: str, user_id: int) -> None:\n 454:         try:\n 455:             numeric = int(session_id)\n 456:         except (TypeError, ValueError) as exc:\n 457:             raise AppError(\n 458:                 code=AuthErrorCode.INVALID_TOKEN,\n 459:                 message=\"Access token is invalid\",\n 460:                 status_code=401,\n 461:             ) from exc\n 462:         record = self._repository.get_session(numeric)\n 463:         now = self._clock()\n 464:         if (\n 465:             record is None\n 466:             or record.user_id != user_id\n 467:             or record.revoked_at is not None\n 468:             or record.expires_at <= now\n 469:         ):\n 470:             raise AppError(\n 471:                 code=AuthErrorCode.SESSION_REVOKED,\n 472:                 message=\"Session is no longer valid\",\n 473:                 status_code=401,\n 474:             )\n 475: \n 476:     def _issue_session(self, *, user_id: int, auth_method: str) -> IssuedSession:\n 477:         refresh = generate_refresh_token()\n 478:         now = self._clock()\n 479:         record = self._repository.add_session(\n 480:             AuthSession(\n 481:                 user_id=user_id,\n 482:                 auth_method=auth_method,\n 483:                 refresh_token_hash=keyed_hash(\n 484:                     refresh, secret=self._settings.app_secret_key.get_secret_value()\n 485:                 ),\n 486:                 expires_at=now + timedelta(seconds=self._settings.jwt_refresh_token_ttl_seconds),\n 487:             )\n 488:         )\n 489:         access = issue_access_token(\n 490:             user_id,\n 491:             self._settings,\n 492:             auth_method=auth_method,\n 493:             session_id=str(record.id),\n 494:             now=now,\n 495:         )\n 496:         return IssuedSession(\n 497:             access_token=access,\n 498:             refresh_token=refresh,\n 499:             token_type=\"bearer\",\n 500:             expires_in=self._settings.jwt_access_token_ttl_seconds,\n 501:             auth_method=auth_method,\n 502:             user_id=user_id,\n 503:             session_id=record.id,\n 504:         )\n 505: \n 506:     def _revoke_sessions(self, user_id: int, *, reason: str, request_id: str) -> None:\n 507:         now = self._clock()\n 508:         for record in self._repository.list_active_sessions(user_id):\n 509:             record.revoked_at = now\n 510:             self._audit.append(\n 511:                 action=AuditAction.AUTH_SESSION_REVOKED,\n 512:                 resource_type=AuditResourceType.AUTH_SESSION,\n 513:                 actor_user_id=user_id,\n 514:                 resource_id=record.id,\n 515:                 request_id=request_id,\n 516:                 scope_type=ScopeType.SYSTEM,\n 517:                 details={\"auth_method\": record.auth_method, \"reason_code\": reason},\n 518:             )\n 519: \n 520:     def _apply_otp(self, phone_e164: str, *, purpose: str, code: str) -> str:\n 521:         challenge = self._repository.get_open_challenge(phone_e164, purpose)\n 522:         now = self._clock()\n 523:         if challenge is None:\n 524:             return \"invalid\"\n 525:         if challenge.expires_at <= now:\n 526:             challenge.consumed_at = now\n 527:             return \"expired\"\n 528:         if challenge.attempts >= challenge.max_attempts:\n 529:             challenge.consumed_at = now\n 530:             return \"exhausted\"\n 531:         expected = keyed_hash(code, secret=self._settings.app_secret_key.get_secret_value())\n 532:    