   api.me().then((me) => {\n        const permissions = me.permissions || [];\n        getApp().globalData.me = me;\n        this.setData({\n          me,\n          canResident: permissions.indexOf(\"work_order:create\") >= 0,\n          canStaff: permissions.indexOf(\"work_order:process\") >= 0,\n          canManage: permissions.indexOf(\"work_order:dispatch\") >= 0,\n          propertyId: firstPropertyId(me),\n          tenantId: firstTenantId(me),\n        });\n      })\n    ).catch(() => {});\n  },\n  retry() {\n    this.onShow();\n  },\n  switchIdentity() {\n    this.logout();\n  },\n  logout() {\n    const auth = require(\"../../services/auth\");\n    const api = require(\"../../services/api\");\n    const refresh = auth.getRefreshToken();\n    const finish = () => {\n      auth.clearSession();\n      wx.reLaunch({ url: \"/pages/login/login\" });\n    };\n    if (!refresh) {\n      finish();\n      return;\n    }\n    api.logout(refresh).then(finish).catch(finish);\n  },\n  openLast() {\n    const id = this.data.lastWorkOrderId;\n    if (!id) {\n      this.setData({ error: \"��û�б�����¼�Ĺ���\" });\n      return;\n    }\n    wx.navigateTo({ url: `/pages/work-orders/detail?id=${id}` });\n  },\n  go(event) {\n    const url = event.currentTarget.dataset.url;\n    const propertyId = this.data.propertyId;\n    const tenantId = this.data.tenantId;\n    const needsProperty =\n      url.indexOf(\"announcements\") >= 0 ||\n      url.indexOf(\"assistant\") >= 0 ||\n      url.indexOf(\"supervisor\") >= 0 ||\n      url.indexOf(\"attendance\") >= 0;\n    if (needsProperty && propertyId) {\n      const join = url.indexOf(\"?\") >= 0 ? \"&\" : \"?\";\n      const tenant = tenantId ? `&tenantId=${tenantId}` : \"\";\n      wx.navigateTo({ url: `${url}${join}propertyId=${propertyId}${tenant}` });\n      return;\n    }\n    wx.navigateTo({ url });\n  },\n});\n\nFILE: miniprogram/services/api.js\nconst { BASE_URL } = require(\"../config/env\");\nconst auth = require(\"./auth\");\nconst { isUnauthorized, messageFromError } = require(\"../utils/error\");\n\nconst CREDENTIAL_AUTH_PATHS = {\n  \"/auth/wechat/login\": true,\n  \"/auth/sms/send\": true,\n  \"/auth/sms/login\": true,\n  \"/auth/password/login\": true,\n  \"/auth/password/reset\": true,\n  \"/auth/token/refresh\": true,\n  \"/auth/dev/token\": true,\n  \"/auth/logout\": true,\n};\n\nfunction sendUnauthorizedToLogin() {\n  auth.clearSession();\n  wx.reLaunch({ url: \"/pages/login/login\" });\n}\n\nlet refreshInFlight = null;\n\nfunction refreshSessionOnce() {\n  if (refreshInFlight) {\n    return refreshInFlight;\n  }\n  const refreshToken = auth.getRefreshToken();\n  if (!refreshToken) {\n    return Promise.reject(new Error(\"�����µ�¼\"));\n  }\n  refreshInFlight = new Promise((resolve, reject) => {\n    wx.request({\n      url: `${BASE_URL}/auth/token/refresh`,\n      method: \"POST\",\n      header: { \"Content-Type\": \"application/json\" },\n      data: { refresh_token: refreshToken },\n      success: (response) => {\n        const payload = response.data || {};\n        if (response.statusCode >= 400) {\n          reject(new Error(messageFromError(payload, \"�����µ�¼\")));\n          return;\n        }\n        const data = payload.data || {};\n        if (!data.access_token) {\n          reject(new Error(\"�����µ�¼\"));\n          return;\n        }\n        auth.setToken(data.access_token);\n        if (data.refresh_token) {\n          auth.setRefreshToken(data.refresh_token);\n        }\n        resolve(data);\n      },\n      fail: () => reject(new Error(\"���粻����\")),\n    });\n  }).finally(() => {\n    refreshInFlight = null;\n  });\n  return refreshInFlight;\n}\n\nfunction request({ path, method, data, headers, retried }) {\n  if (!BASE_URL) {\n    return Promise.reject(new Error(\"δ���� API ��ַ\"));\n  }\n  const token = auth.getToken();\n  const verb = method || \"GET\";\n  const options = {\n    url: `${BASE_URL}${path}`,\n    method: verb,\n    header: {\n      \"Content-Type\": \"application/json\",\n      ...(token ? { Authorization: `Bearer ${token}` } : {}),\n      ...(headers || {}),\n    },\n  };\n  if (data !== undefined) {\n    options.data = data;\n  } else if (verb !== \"GET\") {\n    options.data = {};\n  }\n  return new Promise((resolve, reject) => {\n    wx.request({\n      ...options,\n      success: (response) => {\n        const payload = response.data || {};\n        if (isUnauthorized(response.statusCode, payload)) {\n          if (\n            !retried &&\n            !CREDENTIAL_AUTH_PATHS[path] &&\n            auth.getRefreshToken()\n          ) {\n            refreshSessionOnce()\n              .then(() =>\n                request({ path, method, data, headers, retried: true })\n              )\n              .then(resolve)\n              .catch(() => {\n                sendUnauthorizedToLogin();\n                reject(new Error(\"�����µ�¼\"));\n              });\n            return;\n          }\n          if (CREDENTIAL_AUTH_PATHS[path]) {\n            reject(new Error(messageFromError(payload, \"��֤ʧ��\")));\n            return;\n          }\n          sendUnauthorizedToLogin();\n          reject(new Error(\"�����µ�¼\"));\n          return;\n        }\n        if (response.statusCode === 403) {\n          reject(new Error(messageFromError(payload, \"��Ȩ��\")));\n          return;\n        }\n        if (response.statusCode >= 400) {\n          reject(new Error(messageFromError(payload, \"����ʧ��\")));\n          return;\n        }\n        resolve(payload.data);\n      },\n      fail: () => reject(new Error(\"���粻����\")),\n    });\n  });\n}\n\nfunction uploadFile({ fileId, filePath, retried }) {\n  if (!BASE_URL) {\n    return Promise.reject(new Error(\"δ���� API ��ַ\"));\n  }\n  const token = auth.getToken();\n  return new Promise((resolve, reject) => {\n    wx.uploadFile({\n      url: `${BASE_URL}/files/${fileId}/content`,\n      filePath,\n      name: \"file\",\n      header: token ? { Authorization: `Bearer ${token}` } : {},\n      success: (response) => {\n        let payload = {};\n        try {\n          payload = JSON.parse(response.data || \"{}\");\n        } catch (error) {\n          reject(new Error(\"�ϴ���Ӧ��Ч\"));\n          return;\n        }\n        if (isUnauthorized(response.statusCode, payload)) {\n          if (!retried && auth.getRefreshToken()) {\n            refreshSessionOnce()\n              .then(() => uploadFile({ fileId, filePath, retried: true }))\n              .then(resolve)\n              .catch(() => {\n                sendUnauthorizedToLogin();\n                reject(new Error(\"�����µ�¼\"));\n              });\n            return;\n          }\n          sendUnauthorizedToLogin();\n          reject(new Error(\"�����µ�¼\"));\n          return;\n        }\n        if (response.statusCode >= 400) {\n          reject(new Error(messageFromError(payload, \"�ϴ�ʧ��\")));\n          return;\n        }\n        resolve(payload.data);\n      },\n      fail: () => reject(new Error(\"�ϴ�ʧ�ܣ��������������\")),\n    });\n  });\n}\n\nfunction registerAndUpload({ filePath, mimeType, sizeBytes, originalName, propertyId }) {\n  return request({\n    path: \"/files\",\n    method: \"POST\",\n    data: {\n      mime_type: mimeType,\n      size_bytes: sizeBytes,\n      original_name: originalName,\n      property_id: propertyId || undefined,\n    },\n  }).then((file) => uploadFile({ fileId: file.id, filePath }).then(() => file));\n}\n\nmodule.exports = {\n  request,\n  uploadFile,\n  registerAndUpload,\n  wechatLogin: (code) => request({ path: \"/auth/wechat/login\", method: \"POST\", data: { code } }),\n  wechatBind: (code) => request({ path: \"/auth/wechat/bind\", method: \"POST\", data: { code } }),\n  sendSms: (phone, purpose) =>\n    request({ path: \"/auth/sms/send\", method: \"POST\", data: { phone, purpose: purpose || \"login\" } }),\n  smsLogin: (phone, code) =>\n    request({ path: \"/auth/sms/login\", method: \"POST\", data: { phone