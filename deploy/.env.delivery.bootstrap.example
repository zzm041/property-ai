# Copy to deploy/.env.delivery.bootstrap. This file is read only by the
# one-shot migrate service and is ignored by Git.
PROPERTY_AI_DELIVERY_MIGRATION=approved
PROPERTY_AI_APPROVE_DELIVERY_TARGET=mysql:3306/property_ai_delivery_check
BOOTSTRAP_ADMIN_DISPLAY_NAME=Initial System Administrator
BOOTSTRAP_ADMIN_PHONE=replace-synthetic-or-authorized-phone
BOOTSTRAP_ADMIN_PASSWORD=replace-bootstrap-password
