# Production TLS template. Copy to nginx-tls.conf and mount certificates.
# Do not commit private keys. LIVE TLS = BLOCKED_BY_DOMAIN_CERT until a real
# certificate and server_name are issued.

server {
    listen 80;
    server_name api.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.example.com;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 12m;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
    proxy_connect_timeout 5s;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header X-Request-Id $request_id always;

    location = /healthz {
        proxy_pass http://api:8000/api/v1/healthz;
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $http_x_request_id;
    }

    location = /readyz {
        proxy_pass http://api:8000/api/v1/readyz;
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $http_x_request_id;
    }

    location /api/ {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 60s;
        client_max_body_size 12m;
    }
}
