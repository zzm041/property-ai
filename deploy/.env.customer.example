# NEW installation template. Replace placeholders; never use the local delivery env.
# No service is started by copying this example.
CUSTOMER_PROJECT_NAME=customer-property-ai
DELIVERY_ENV_FILE=.env.customer
CUSTOMER_BOOTSTRAP_ENV_FILE=.env.customer.bootstrap
DELIVERY_IMAGE_TAG=replace-reviewed-release-tag
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=replace-at-least-32-random-characters
DEV_AUTH_ENABLED=false
IDENTITY_TEST_PROOF_ENABLED=false

MYSQL_DATABASE=client_property
MYSQL_USER=property_app
MYSQL_PASSWORD=replace-mysql-password
MYSQL_ROOT_PASSWORD=replace-mysql-root-password
DATABASE_URL=mysql+pymysql://property_app:replace-url-encoded-mysql-password@mysql:3306/client_property?charset=utf8mb4
MYSQL_HOST_PORT=3337
REDIS_PASSWORD=replace-redis-password
REDIS_URL=redis://:replace-url-encoded-redis-password@redis:6379/0
REDIS_HOST_PORT=6402
RABBITMQ_USER=property_app
RABBITMQ_PASSWORD=replace-rabbit-password
RABBITMQ_VHOST=client_property
RABBITMQ_HOST_PORT=5695
RABBITMQ_MANAGEMENT_HOST_PORT=15695
CELERY_BROKER_URL=amqp://property_app:replace-url-encoded-rabbit-password@rabbitmq:5672/client_property
CELERY_TASK_QUEUE=property_ai.customer
DURABLE_TASKS_ENABLED=true

MINIO_ROOT_USER=replace-minio-admin
MINIO_ROOT_PASSWORD=replace-minio-admin-password
MINIO_HOST_PORT=9030
MINIO_CONSOLE_HOST_PORT=9031
STORAGE_PROVIDER=production
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=customer-property-media
STORAGE_ACCESS_KEY=replace-dedicated-bucket-access-key
STORAGE_SECRET_KEY=replace-dedicated-bucket-secret
FILE_SCANNER_PROVIDER=clamav
# Numeric private IP reachable FROM the API container, not a DNS name.
FILE_SCANNER_HOST=
FILE_SCANNER_PORT=3310
FILE_SCANNER_TIMEOUT_SECONDS=10
UPLOAD_MAX_MB=10

MILVUS_HOST_PORT=19551
MILVUS_HEALTH_HOST_PORT=9104
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=customer_knowledge_bge_m3_1024
MILVUS_METRIC_TYPE=COSINE
HTTP_HOST_PORT=8103
WECHAT_LOGIN_ENABLED=true
WECHAT_PROVIDER=production
WECHAT_APP_ID=
WECHAT_APP_SECRET=
SMS_PROVIDER=production
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=
SMS_ALIYUN_PASSWORD_RESET_TEMPLATE_CODE=
SMS_ALIYUN_PHONE_CHANGE_TEMPLATE_CODE=

# Self-hosted model endpoints controlled by the operator; no simulated AI.
LLM_PROVIDER=production
LLM_BASE_URL=
LLM_MODEL=replace-reviewed-qwen-model-id
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_DISABLE_THINKING=true
LLM_MAX_OUTPUT_TOKENS=512
RAG_LLM_PROVIDER=production
RAG_LLM_BASE_URL=
RAG_LLM_MODEL=replace-reviewed-rag-model-id
RAG_LLM_API_KEY=
RAG_LLM_TIMEOUT_SECONDS=60
RAG_LLM_DISABLE_THINKING=true
RAG_LLM_MAX_OUTPUT_TOKENS=512
VLM_PROVIDER=production
VLM_BASE_URL=
VLM_MODEL=replace-reviewed-vision-model-id
VLM_MODEL_REVISION=
VLM_API_KEY=
VLM_TIMEOUT_SECONDS=60
VLM_DISABLE_THINKING=true
VLM_MAX_OUTPUT_TOKENS=256
ASR_PROVIDER=production
ASR_BASE_URL=
ASR_MODEL=replace-reviewed-asr-model-id
ASR_MODEL_REVISION=
ASR_API_KEY=
ASR_TIMEOUT_SECONDS=120
EMBEDDING_PROVIDER=production
EMBEDDING_ENDPOINT=
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_DIMENSIONS=1024
EMBEDDING_REVISION=
EMBEDDING_NORMALIZATION=l2
RERANKER_PROVIDER=production
RERANKER_ENDPOINT=
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_API_KEY=
RERANKER_TIMEOUT_SECONDS=30
AI_ENQUEUE_ON_CREATE=true
AI_AUTO_ASSIGN=true
DISPATCH_REJECT_COOLDOWN_SECONDS=600
