# Copy to deploy/.env.delivery. Never commit the populated file.
COMPOSE_PROJECT_NAME=property-ai-delivery-check
DELIVERY_ENV_FILE=.env.delivery
DELIVERY_IMAGE_TAG=local
APP_ENV=staging
APP_DEBUG=false
APP_SECRET_KEY=replace-with-at-least-32-random-characters
DEV_AUTH_ENABLED=false
IDENTITY_TEST_PROOF_ENABLED=false

MYSQL_DATABASE=property_ai_delivery_check
MYSQL_USER=property_delivery
MYSQL_PASSWORD=replace-mysql-password
MYSQL_ROOT_PASSWORD=replace-mysql-root-password
MYSQL_HOST_PORT=3327
MYSQL_VOLUME_NAME=property-ai-delivery-check-mysql-data-v2
DATABASE_URL=mysql+pymysql://property_delivery:replace-mysql-password@mysql:3306/property_ai_delivery_check?charset=utf8mb4

REDIS_PASSWORD=replace-redis-password
REDIS_HOST_PORT=6392
REDIS_URL=redis://:replace-redis-password@redis:6379/0

RABBITMQ_USER=property_delivery
RABBITMQ_PASSWORD=replace-rabbit-password
RABBITMQ_VHOST=property_ai_delivery_check
RABBITMQ_HOST_PORT=5685
RABBITMQ_MANAGEMENT_HOST_PORT=15685
CELERY_BROKER_URL=amqp://property_delivery:replace-rabbit-password@rabbitmq:5672/property_ai_delivery_check
CELERY_TASK_QUEUE=property_ai.delivery_check
DURABLE_TASKS_ENABLED=true

MINIO_ROOT_USER=propertydelivery
MINIO_ROOT_PASSWORD=replace-minio-password
MINIO_HOST_PORT=9020
MINIO_CONSOLE_HOST_PORT=9021
STORAGE_PROVIDER=production
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=property-ai-delivery-check
STORAGE_ACCESS_KEY=propertydelivery
STORAGE_SECRET_KEY=replace-minio-password
STORAGE_REGION=us-east-1
FILE_SCANNER_PROVIDER=unavailable
# Numeric private IP; hostname/DNS is refused to keep the upload timeout bounded.
FILE_SCANNER_HOST=
FILE_SCANNER_PORT=3310
FILE_SCANNER_TIMEOUT_SECONDS=10

MILVUS_HOST_PORT=19541
MILVUS_HEALTH_HOST_PORT=9094
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=knowledge_chunks_delivery_check
MILVUS_METRIC_TYPE=IP

HTTP_HOST_PORT=8093
WECHAT_LOGIN_ENABLED=true
WECHAT_PROVIDER=development
WECHAT_APP_ID=wx-dev-app
WECHAT_APP_SECRET=
SMS_PROVIDER=development
# 阿里云号码认证服务 PNVS；以下只填本机忽略文件，示例保持空值。
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
# 登录/注册、初始密码/忘记密码、换绑分别使用对应的系统赠送模板 Code。
SMS_ALIYUN_TEMPLATE_CODE=
SMS_ALIYUN_PASSWORD_RESET_TEMPLATE_CODE=
SMS_ALIYUN_PHONE_CHANGE_TEMPLATE_CODE=
# 8093 本轮真实短信验收唯一允许的自有大陆手机号，格式 +86 后接 11 位手机号。
SMS_LIVE_ALLOWED_PHONE_E164=
NOTIFICATION_PROVIDER=development

# Clean deployment rehearsal uses explicit Development AI. For a self-hosted
# target, set each provider to production and point it at the owner-controlled
# service. Never put resident content through an unapproved public proxy.
LLM_PROVIDER=development
LLM_BASE_URL=
LLM_MODEL=qwen3.5:4b
LLM_API_KEY=
# Each explicit provider key takes precedence. Existing local launchers may
# supply DELIVERY_WORK_AI_INTERNAL_TOKEN as a fallback only when a key is empty.
# Never place a backend/model key in the mini program or browser demo.
LLM_DISABLE_THINKING=true
LLM_MAX_OUTPUT_TOKENS=512
# Keep work-order analysis independently gated while enabling an approved
# self-hosted knowledge-answer model. "inherit" preserves the old behavior.
RAG_LLM_PROVIDER=inherit
RAG_LLM_BASE_URL=
RAG_LLM_MODEL=qwen3.5:4b
RAG_LLM_API_KEY=
RAG_LLM_TIMEOUT_SECONDS=60
RAG_LLM_DISABLE_THINKING=true
RAG_LLM_MAX_OUTPUT_TOKENS=512
# Optional shared secret for the local loopback/host.docker.internal adapter.
# External providers continue to use their independent provider-specific keys.
LOCAL_AI_INTERNAL_TOKEN=
VLM_PROVIDER=development
VLM_BASE_URL=
VLM_MODEL=qwen3.5:4b
VLM_API_KEY=
VLM_DISABLE_THINKING=true
VLM_MAX_OUTPUT_TOKENS=256
ASR_PROVIDER=development
ASR_BASE_URL=
ASR_MODEL=
ASR_API_KEY=
EMBEDDING_PROVIDER=development
EMBEDDING_ENDPOINT=
EMBEDDING_TIMEOUT_SECONDS=45
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=8
EMBEDDING_REVISION=
EMBEDDING_NORMALIZATION=unspecified
RERANKER_PROVIDER=development
RERANKER_ENDPOINT=
RERANKER_TIMEOUT_SECONDS=15
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_API_KEY=

AI_ENQUEUE_ON_CREATE=true
AI_AUTO_ASSIGN=true
DISPATCH_REJECT_COOLDOWN_SECONDS=600
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_READ_TIMEOUT_SECONDS=60
SLA_SWEEP_INTERVAL_SECONDS=30
NOTIFICATION_RETRY_SWEEP_INTERVAL_SECONDS=30
