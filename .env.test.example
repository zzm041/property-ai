# Copy to .env.test for local integration tests. Never point this at development or production.
APP_ENV=test
APP_DEBUG=false
APP_SECRET_KEY=test-only-not-for-production
APP_TZ=Asia/Shanghai

API_HOST=127.0.0.1
API_PORT=8001

DATABASE_URL=mysql+pymysql://property:change-me@127.0.0.1:3306/property_ai?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://property_test:change-me-test@127.0.0.1:3307/property_ai_test?charset=utf8mb4
ALLOW_DESTRUCTIVE_TEST_DATABASE=true

REDIS_URL=redis://127.0.0.1:6379/15
CELERY_BROKER_URL=amqp://property:change-me@127.0.0.1:5672/property_ai
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/14

READINESS_TIMEOUT_SECONDS=2.0

SMS_PROVIDER=development
REALNAME_PROVIDER=development
LLM_PROVIDER=development
VISION_PROVIDER=development
ASR_PROVIDER=development
STORAGE_PROVIDER=development
NOTIFICATION_PROVIDER=development
