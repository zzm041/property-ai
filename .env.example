# Copy to .env. Never commit real secrets.
APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_TZ=Asia/Shanghai
DEV_AUTH_ENABLED=false
JWT_ISSUER=property-ai
JWT_AUDIENCE=property-ai-api
JWT_ACCESS_TOKEN_TTL_SECONDS=900
DEV_SEED_LOCK_TIMEOUT_SECONDS=5

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database (critical)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=property_ai
MYSQL_USER=property
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
DATABASE_URL=mysql+pymysql://property:change-me@127.0.0.1:3306/property_ai?charset=utf8mb4

# Disposable MySQL 8 integration-test instance (Docker Compose profile: test)
TEST_MYSQL_HOST=127.0.0.1
TEST_MYSQL_PORT=3307
TEST_MYSQL_DB=property_ai_test
TEST_MYSQL_USER=property_test
TEST_MYSQL_PASSWORD=change-me-test
TEST_MYSQL_ROOT_PASSWORD=change-me-test-root
TEST_DATABASE_URL=mysql+pymysql://property_test:change-me-test@127.0.0.1:3307/property_ai_test?charset=utf8mb4
ALLOW_DESTRUCTIVE_TEST_DATABASE=false

# Redis — isolate by DB index per APP_ENV. Do not share with production.
# development=/0  test=/2  staging=/3  production=/4
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6379/0

# RabbitMQ / Celery
# Queue isolation: default CELERY_TASK_QUEUE=property_ai.{APP_ENV}
# Development worker must never consume production/test backlog.
# Optional override, otherwise resolved as property_ai.{APP_ENV}
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=property
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=property_ai
CELERY_BROKER_URL=amqp://property:change-me@127.0.0.1:5672/property_ai
CELERY_TASK_QUEUE=
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# SQLAlchemy V1 pool (API process)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# Readiness probes
DISPATCH_REJECT_COOLDOWN_SECONDS=600
READINESS_TIMEOUT_SECONDS=2.0

# Milvus — Fake collection (dim=8) vs production BGE-M3 collection must be isolated.
# Do not change historical Alembic migrations to retarget dimensions.
# development=knowledge_chunks_v1  test=knowledge_chunks_test
# staging=knowledge_chunks_staging  production=knowledge_chunks_bge_m3_v1
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=knowledge_chunks_v1
# Production example (BGE-M3, typically 1024):
# MILVUS_COLLECTION=knowledge_chunks_bge_m3_v1
# EMBEDDING_DIMENSIONS=1024

# WeChat Mini Program (production fail-fast when WECHAT_LOGIN_ENABLED=true)
WECHAT_LOGIN_ENABLED=true
WECHAT_PROVIDER=development
WECHAT_APP_ID=wx-dev-app
WECHAT_APP_SECRET=
WECHAT_TIMEOUT_SECONDS=5.0

# LLM — Qwen-compatible OpenAI chat completions
LLM_PROVIDER=development
LLM_BASE_URL=
LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=8.0

# VLM — Qwen-VL compatible; suggestion input only
VLM_PROVIDER=development
VLM_BASE_URL=
VLM_MODEL=qwen-vl-plus
VLM_API_KEY=
VLM_TIMEOUT_SECONDS=12.0

# ASR — OpenAI-compatible /audio/transcriptions
ASR_PROVIDER=development
ASR_BASE_URL=
ASR_MODEL=paraformer-realtime-v2
ASR_API_KEY=
ASR_TIMEOUT_SECONDS=20.0

# Embedding — HTTP BGE-M3. Do not load the model into the FastAPI process.
EMBEDDING_PROVIDER=development
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=8
EMBEDDING_TIMEOUT_SECONDS=8.0

# Reranker — optional; down = ACL-valid retrieval without rerank
RERANKER_PROVIDER=development
RERANKER_ENDPOINT=
RERANKER_API_KEY=
RERANKER_MODEL=bge-reranker
RERANKER_TIMEOUT_SECONDS=5.0

# Object storage — Development in-process; production = MinIO / S3-compatible
# Isolate buckets: property-ai-dev / property-ai-test / property-ai-staging / property-ai-prod
STORAGE_PROVIDER=development
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
STORAGE_PRESIGN_TTL_SECONDS=300

# Notification external push (in-app outbox always written)
NOTIFICATION_PROVIDER=development

# Provider mode leftovers used by Day 1 fakes
SMS_PROVIDER=development
REALNAME_PROVIDER=development

# File upload
FILE_SCANNER_PROVIDER=unavailable
# Set clamav only with a deployment-controlled private clamd service; HOST is a numeric private IP, not DNS.
FILE_SCANNER_HOST=
FILE_SCANNER_PORT=3310
FILE_SCANNER_TIMEOUT_SECONDS=10
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,audio/mpeg,audio/wav,audio/mp4
