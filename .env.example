# Copy to .env. Never commit real secrets.
APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_TZ=Asia/Shanghai

# API
API_HOST=0.0.0.0
API_PORT=8000

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=property_ai
MYSQL_USER=property
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
DATABASE_URL=mysql+pymysql://property:change-me@127.0.0.1:3306/property_ai?charset=utf8mb4

# Disposable MySQL 8 integration-test instance (Docker Compose profile: test)
TEST_MYSQL_HOST=127.0.0.1
TEST_MYSQL_PORT=3307
TEST_MYSQL_DB=property_ai_test
TEST_MYSQL_USER=property_test
TEST_MYSQL_PASSWORD=change-me-test
TEST_MYSQL_ROOT_PASSWORD=change-me-test-root
TEST_DATABASE_URL=mysql+pymysql://property_test:change-me-test@127.0.0.1:3307/property_ai_test?charset=utf8mb4

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6379/0

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=property
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=property_ai

# Celery
CELERY_BROKER_URL=amqp://property:change-me@127.0.0.1:5672/property_ai
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Readiness probes
READINESS_TIMEOUT_SECONDS=2.0

# Milvus (RAG, later phase)
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# Provider mode: development | production
SMS_PROVIDER=development
REALNAME_PROVIDER=development
LLM_PROVIDER=development
VISION_PROVIDER=development
ASR_PROVIDER=development
STORAGE_PROVIDER=development
NOTIFICATION_PROVIDER=development

# Production provider credentials — leave empty in local/dev
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
SMS_API_KEY=
SMS_API_SECRET=
REALNAME_API_KEY=
REALNAME_API_SECRET=
QWEN_API_KEY=
QWEN_API_BASE=
ASR_API_KEY=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# File upload
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,audio/mpeg,audio/wav,audio/mp4
