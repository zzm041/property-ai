{
  "json_schema": {
    "name": "work_order_analysis",
    "schema": {
      "$defs": {
        "Observation": {
          "additionalProperties": false,
          "properties": {
            "label": {
              "enum": ["滴渗水", "不出水", "不能供电", "火花烧损", "不制冷", "噪声", "杂物清扫", "敲门按铃", "疑似燃气气味", "烧焦变色", "焦煳气味", "松动", "水渍", "表面剥落", "外观无明显异常", "现象待核实"],
              "title": "Label",
              "type": "string"
            },
            "quote": {
              "description": "当前来源中的唯一逐字证据；保留本项对象、否定、猜测和时态",
              "maxLength": 160,
              "minLength": 2,
              "title": "Quote",
              "type": "string"
            },
            "source": {
              "enum": ["report", "asr", "vision"],
              "title": "Source",
              "type": "string"
            },
            "subject": {
              "description": "必须由本项quote内的字面证据支持；quote未出现现有枚举主体时只能填未确定，不得借相邻句补全",
              "enum": ["水龙头", "排水接头", "天花墙面", "插座", "照明", "空调", "扶手", "楼道地面", "房门", "阀门管道", "未确定"],
              "title": "Subject",
              "type": "string"
            }
          },
          "required": ["label", "subject", "source", "quote"],
          "title": "Observation",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": ["water_supply", "electrical", "hvac", "cleaning", "security", "other"],
          "title": "Category",
          "type": "string"
        },
        "confidence": {"maximum": 1.0, "minimum": 0.0, "title": "Confidence", "type": "number"},
        "observations": {
          "items": {"$ref": "#/$defs/Observation"},
          "maxItems": 6,
          "minItems": 1,
          "title": "Observations",
          "type": "array"
        },
        "priority": {"enum": ["p1", "p2", "p3", "p4"], "title": "Priority", "type": "string"},
        "required_role": {"const": "STAFF", "title": "Required Role", "type": "string"},
        "required_skill": {"enum": ["maintenance", "cleaning", "security", "other"], "title": "Required Skill", "type": "string"},
        "risk": {"enum": ["none", "safety", "flooding", "electric", "gas", "other"], "title": "Risk", "type": "string"},
        "severity": {"enum": ["low", "medium", "high"], "title": "Severity", "type": "string"},
        "summary": {"maxLength": 255, "minLength": 1, "title": "Summary", "type": "string"}
      },
      "required": ["category", "observations", "severity", "priority", "summary", "risk", "required_role", "required_skill", "confidence"],
      "title": "ObservedAnalysisOutput",
      "type": "object"
    },
    "strict": true
  },
  "type": "json_schema"
}
