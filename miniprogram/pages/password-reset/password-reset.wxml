<view class="card">
  <view class="section-title">重置密码</view>
  <view class="empty">重置成功后请返回登录，不会自动登录。</view>
</view>
<view class="card" wx:if="{{step === 1}}">
  <input placeholder="手机号" value="{{phone}}" bindinput="onPhone" type="number" />
  <view class="empty" wx:if="{{challengePrompt}}">安全挑战：{{challengePrompt}}</view>
  <input wx:if="{{challengePrompt}}" placeholder="挑战答案" value="{{challengeAnswer}}" bindinput="onChallengeAnswer" />
  <input placeholder="短信验证码" value="{{smsCode}}" bindinput="onSmsCode" />
  <button class="btn" bindtap="sendSms" disabled="{{loading}}">获取验证码</button>
  <button class="btn" bindtap="verify" disabled="{{loading}}">验证短信</button>
</view>
<view class="card" wx:if="{{step === 2}}">
  <view class="password-row">
    <input class="grow" placeholder="新密码" value="{{newPassword}}" bindinput="onNewPassword" password="{{!showPassword}}" />
    <button class="link" bindtap="togglePassword">{{showPassword ? "隐藏" : "显示"}}</button>
  </view>
  <input placeholder="确认新密码" value="{{confirmPassword}}" bindinput="onConfirm" password="{{!showPassword}}" />
  <view class="empty">强度：{{strength}}（至少 8 个字符，不强制大写；不能是纯数字或纯小写字母）</view>
  <button class="btn" bindtap="confirm" disabled="{{loading}}">确认重置</button>
</view>
<button class="btn" bindtap="back">返回登录</button>
<view class="loading" wx:if="{{loading}}">处理中...</view>
<view class="error" wx:if="{{error}}">{{error}}</view>
