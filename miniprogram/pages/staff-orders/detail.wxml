<view class="loading" wx:if="{{loading}}">加载中...</view>
<view class="card" wx:if="{{workOrder}}">
  <view>工单 {{workOrder.id}}</view>
  <view>状态 {{workOrder.status}}</view>
  <button class="btn" wx:if="{{canAccept}}" bindtap="accept">接单</button>
  <button class="btn" wx:if="{{canStart}}" bindtap="start">开始处理</button>
  <block wx:if="{{canFinish}}">
    <button class="btn" bindtap="chooseAfterImage">完工照片（可选）</button>
    <view class="empty" wx:if="{{mediaHint}}">{{mediaHint}}</view>
    <textarea placeholder="处理反馈（可选）" bindinput="onFeedback"></textarea>
    <button class="btn" bindtap="feedback">提交反馈</button>
    <button class="btn" bindtap="resolve">填写回执并完成</button>
  </block>
</view>
<view class="card" wx:if="{{logs.length}}">
  <view>历史</view>
  <view wx:for="{{logs}}" wx:key="id">{{item.from_status}} → {{item.to_status}} {{item.event_code}}</view>
</view>
<button class="btn" bindtap="reload">刷新</button>
<view class="error" wx:if="{{error}}">{{error}}</view>
