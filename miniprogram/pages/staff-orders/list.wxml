<view class="loading" wx:if="{{loading}}">加载中...</view>
<view class="empty" wx:if="{{!loading && !items.length}}">暂无任务</view>
<view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
  <view class="section-title">工单 {{item.id}}</view>
  <view>{{item.statusLabel}}</view>
</view>
<button class="btn" bindtap="onShow">重试</button>
<view class="error" wx:if="{{error}}">{{error}}</view>
