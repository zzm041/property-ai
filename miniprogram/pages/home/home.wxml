<view class="card" wx:if="{{envNote}}">{{envNote}}</view>
<view class="loading" wx:if="{{loading}}">加载中...</view>
<view class="card" wx:if="{{me}}">
  <view>{{me.display_name}}</view>
</view>
<view class="card">
  <button class="btn" data-url="/pages/profile/profile" bindtap="go">账号与安全</button>
  <button class="btn" data-url="/pages/houses/houses" bindtap="go">房屋选择 / 绑定</button>
  <button class="btn" data-url="/pages/employee-claim/employee-claim" bindtap="go">认领物业员工邀请</button>
</view>
<view class="card" wx:if="{{canResident}}">
  <button class="btn" data-url="/pages/work-orders/create" bindtap="go">报修</button>
  <button class="btn" data-url="/pages/work-orders/list" bindtap="go">我的工单</button>
  <button class="btn" data-url="/pages/announcements/list" bindtap="go">公告</button>
</view>
<view class="card" wx:if="{{canReadKnowledge}}">
  <button class="btn" data-url="/pages/assistant/assistant" bindtap="go">知识助手</button>
</view>
<view class="card" wx:if="{{canStaff}}">
  <button class="btn" data-url="/pages/attendance/attendance" bindtap="go">今日考勤</button>
  <button class="btn" data-url="/pages/staff-orders/list" bindtap="go">我的任务</button>
</view>
<view class="card" wx:if="{{canManage}}">
  <button class="btn" data-url="/pages/supervisor/queue" bindtap="go">待派工单</button>
  <button class="btn" data-url="/pages/supervisor/announcements" bindtap="go">公告审核</button>
  <button class="btn" data-url="/pages/supervisor/bindings" bindtap="go">绑定审核</button>
</view>
<view class="card" wx:if="{{canViewIncidents}}">
  <button class="btn" data-url="/pages/supervisor/incidents" bindtap="go">{{canManageIncidents ? '事件管理' : '我参与的事件'}}</button>
</view>
<view class="card" wx:if="{{canManageStaff}}">
  <button class="btn" data-url="/pages/supervisor/staff" bindtap="go">员工管理与状态</button>
</view>
<view class="card" wx:if="{{canManageKnowledge}}">
  <button class="btn" data-url="/pages/supervisor/knowledge" bindtap="go">知识库维护</button>
</view>
<view class="card" wx:if="{{canManageSla}}">
  <button class="btn" data-url="/pages/supervisor/sla" bindtap="go">SLA 策略管理</button>
</view>
<view class="card" wx:if="{{canReviewIdentity}}">
  <button class="btn" data-url="/pages/supervisor/identity-recovery" bindtap="go">身份恢复审核</button>
</view>
<view class="card" wx:if="{{canViewStats}}">
  <button class="btn" data-url="/pages/supervisor/dashboard" bindtap="go">运营统计与配置</button>
</view>
<view class="card" wx:if="{{canViewProperty}}">
  <button class="btn" data-url="/pages/supervisor/properties" bindtap="go">楼栋房屋与住户关系</button>
</view>
<button class="btn" data-url="/pages/notifications/list" bindtap="go">通知</button>
<button class="btn" wx:if="{{lastWorkOrderId}}" bindtap="openLast">最近工单</button>
<button class="btn" bindtap="logout">退出登录</button>
<button class="btn" bindtap="retry">重试</button>
<view class="error" wx:if="{{error}}">{{error}}</view>
