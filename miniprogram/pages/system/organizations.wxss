.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

input,
textarea {
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  box-sizing: border-box;
  margin: 12rpx 0;
  padding: 18rpx;
  width: 100%;
}

.hint {
  color: #667085;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.notice {
  color: #067647;
  margin: 16rpx 24rpx;
}
