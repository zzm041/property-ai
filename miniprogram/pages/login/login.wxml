<view class="card">
  <view class="section-title">登录</view>
</view>
<view class="card">
  <input placeholder="手机号" value="{{phone}}" bindinput="onPhone" type="number" />
  <view class="password-row" wx:if="{{mode === 'password'}}">
    <input
      class="grow"
      placeholder="密码"
      value="{{password}}"
      bindinput="onPassword"
      password="{{!showPassword}}"
    />
    <button class="link" bindtap="togglePassword">{{showPassword ? "隐藏" : "显示"}}</button>
  </view>
  <view wx:if="{{mode === 'sms'}}">
    <view class="empty" wx:if="{{challengePrompt}}">安全挑战：{{challengePrompt}}</view>
    <input
      wx:if="{{challengePrompt}}"
      placeholder="挑战答案"
      value="{{challengeAnswer}}"
      bindinput="onChallengeAnswer"
    />
    <view class="password-row">
      <input class="grow" placeholder="短信验证码" value="{{smsCode}}" bindinput="onSmsCode" />
      <button id="sms-send" class="link" bindtap="sendSms" disabled="{{loading || cooldown > 0}}">
        {{cooldown > 0 ? cooldown + "s" : "获取验证码"}}
      </button>
    </view>
  </view>
  <button id="login-submit" class="btn" bindtap="submit" disabled="{{loading}}">登录</button>
  <view class="secondary">
    <text id="forgot-password-link" class="link-text" bindtap="goReset">忘记密码</text>
    <text id="login-mode-toggle" class="link-text" bindtap="toggleMode">{{mode === "password" ? "验证码登录" : "密码登录"}}</text>
  </view>
  <view class="empty">已绑定微信的账号可用微信作为次级登录方式。</view>
  <button id="wechat-login-button" class="link" bindtap="loginWechat" disabled="{{loading}}">微信登录</button>
</view>
<view class="loading" wx:if="{{loading}}">处理中...</view>
<view class="error" wx:if="{{error}}">{{error}}</view>
