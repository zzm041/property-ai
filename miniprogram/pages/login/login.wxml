<view class="card">
  <view>智慧物业 · 统一账号登录</view>
  <view class="empty">{{providerNote}}</view>
  <view class="empty" wx:if="{{baseUrl}}">API {{baseUrl}}</view>
</view>
<view class="card">
  <view>手机号登录</view>
  <input placeholder="手机号" value="{{phone}}" bindinput="onPhone" type="number" />
  <input placeholder="短信验证码" value="{{smsCode}}" bindinput="onSmsCode" />
  <button class="btn" bindtap="sendSms" disabled="{{loading}}">发送验证码</button>
  <button class="btn" bindtap="loginSms" disabled="{{loading}}">验证码登录</button>
</view>
<view class="card">
  <view>手机号 + 密码</view>
  <input placeholder="密码" value="{{password}}" bindinput="onPassword" password />
  <button class="btn" bindtap="loginPassword" disabled="{{loading}}">密码登录</button>
  <button class="btn" bindtap="toggleReset">忘记密码</button>
</view>
<view class="card" wx:if="{{showReset}}">
  <view>重置密码（开发短信替身，不是真实短信验收）</view>
  <input placeholder="短信验证码" value="{{resetCode}}" bindinput="onResetCode" />
  <input placeholder="新密码" value="{{newPassword}}" bindinput="onNewPassword" password />
  <button class="btn" bindtap="sendResetSms" disabled="{{loading}}">发送重置验证码</button>
  <button class="btn" bindtap="resetPassword" disabled="{{loading}}">重置并登录</button>
</view>
<view class="card">
  <button class="btn" bindtap="loginWechat" disabled="{{loading}}">微信登录（需已绑定同一账号）</button>
  <view class="empty">未绑定微信时不会自动建号。请先用手机号验证，再在资料页绑定微信。</view>
</view>
<view class="card" wx:if="{{localPreview}}">
  <view>本地调试 Seed（仅 develop + env.local.js，非正式路径）</view>
  <button
    class="btn"
    wx:for="{{identities}}"
    wx:key="seedKey"
    data-seed="{{item.seedKey}}"
    bindtap="loginLocal"
    disabled="{{loading}}"
  >以{{item.label}}登录</button>
</view>
<view class="loading" wx:if="{{loading}}">登录中...</view>
<view class="error" wx:if="{{error}}">{{error}}</view>
