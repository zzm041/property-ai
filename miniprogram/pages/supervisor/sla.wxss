.section-title,
.section-heading {
  font-weight: 600;
  margin-bottom: 16rpx;
}

.section-heading {
  margin: 24rpx;
}

.picker,
input {
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  margin: 12rpx 0;
  padding: 18rpx;
}

.field-label {
  color: #344054;
  margin-top: 16rpx;
}

.hint {
  color: #667085;
  font-size: 24rpx;
  margin-top: 12rpx;
}

.notice {
  color: #067647;
  margin: 16rpx 24rpx;
}

.warning-card {
  border-left: 8rpx solid #f79009;
}

.warning-card view {
  margin-top: 10rpx;
}

.policy-row view + view {
  margin-top: 8rpx;
}
