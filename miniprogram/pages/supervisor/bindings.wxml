<input placeholder="小区 ID" value="{{propertyId}}" bindinput="onProperty" disabled="{{loading}}" />
<button class="btn" bindtap="load" disabled="{{loading}}">加载绑定申请</button>
<textarea placeholder="驳回原因（仅拒绝时必填，住户可见）" value="{{rejectReason}}" bindinput="onRejectReason" maxlength="500" disabled="{{loading}}" />
<view class="loading" wx:if="{{loading}}">加载中...</view>
<view class="empty" wx:if="{{!loading && !items.length}}">暂无申请</view>
<view class="card" wx:for="{{items}}" wx:key="id">
  申请 {{item.id}} · {{item.status}} · {{item.relation_type}} · 房屋 {{item.house_id}}
  <button class="btn" wx:if="{{item.status === 'PENDING'}}" data-id="{{item.id}}" bindtap="approve" disabled="{{loading}}">通过</button>
  <button class="btn" wx:if="{{item.status === 'PENDING'}}" data-id="{{item.id}}" bindtap="reject" disabled="{{loading}}">拒绝</button>
</view>
<view class="error" wx:if="{{error}}">{{error}}</view>
