<input placeholder="小区 ID" value="{{propertyId}}" bindinput="onProperty" />
<button class="btn" bindtap="load">加载绑定申请</button>
<view class="loading" wx:if="{{loading}}">加载中...</view>
<view class="empty" wx:if="{{!loading && !items.length}}">暂无申请</view>
<view class="card" wx:for="{{items}}" wx:key="id">
  {{item.id}} {{item.status}}
  <button class="btn" data-id="{{item.id}}" bindtap="approve">通过</button>
  <button class="btn" data-id="{{item.id}}" bindtap="reject">拒绝</button>
</view>
<view class="error" wx:if="{{error}}">{{error}}</view>
