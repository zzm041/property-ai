<input placeholder="小区 ID" value="{{propertyId}}" bindinput="onProperty" />
<button class="btn" bindtap="load">加载事件</button>
<view class="loading" wx:if="{{loading}}">加载中...</view>
<view class="empty" wx:if="{{!loading && !items.length}}">暂无事件</view>
<view class="card" wx:for="{{items}}" wx:key="id">{{item.id}} {{item.category}}</view>
<view class="error" wx:if="{{error}}">{{error}}</view>
