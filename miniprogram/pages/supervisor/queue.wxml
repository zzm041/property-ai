<input placeholder="小区 ID" value="{{propertyId}}" bindinput="onProperty" />
<button class="btn" bindtap="load">加载队列</button>
<view class="loading" wx:if="{{loading}}">加载中...</view>
<view class="empty" wx:if="{{!loading && !items.length}}">暂无待派工单</view>
<view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="select">
  {{item.id}} {{item.status}} {{selectedId == item.id ? "已选" : ""}}
</view>
<input placeholder="员工 ID" bindinput="onEmployee" />
<button class="btn" bindtap="recommend">AI 建议</button>
<button class="btn" bindtap="assign">派单</button>
<button class="btn" bindtap="reassign">改派</button>
<view class="card" wx:for="{{recommendations}}" wx:key="employee_id">
  员工 {{item.employee_id}} 分 {{item.score}} {{item.eligible ? "可派" : item.filter_reason}}
</view>
<view class="error" wx:if="{{error}}">{{error}}</view>
