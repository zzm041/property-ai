<view class="card">
  <view class="section-title">知识库管理范围</view>
  <picker range="{{properties}}" range-key="name" value="{{propertyIndex}}" bindchange="onPropertyChange">
    <view class="picker">{{properties[propertyIndex].name || '请选择小区'}}</view>
  </picker>
  <view class="hint">只显示当前身份具有 knowledge:manage 权限的范围。企业级知识仅租户级管理员可维护。</view>
</view>

<view class="loading" wx:if="{{loading}}">处理中...</view>
<view class="notice" wx:if="{{notice}}">{{notice}}</view>
<view class="error" wx:if="{{error}}">{{error}}</view>

<view class="card">
  <view class="section-title">新建知识文档</view>
  <picker range="{{scopeOptions}}" range-key="label" value="{{scopeIndex}}" bindchange="onScopeChange">
    <view class="picker">范围：{{scopeOptions[scopeIndex].label}}</view>
  </picker>
  <picker range="{{typeOptions}}" value="{{typeIndex}}" bindchange="onTypeChange">
    <view class="picker">类型：{{typeOptions[typeIndex]}}</view>
  </picker>
  <picker range="{{visibilityOptions}}" value="{{visibilityIndex}}" bindchange="onVisibilityChange">
    <view class="picker">可见性：{{visibilityOptions[visibilityIndex]}}</view>
  </picker>
  <input placeholder="文档标题" value="{{title}}" data-field="title" bindinput="onField" />
  <textarea class="source-box" placeholder="粘贴本版本知识正文" value="{{sourceText}}" data-field="sourceText" bindinput="onField" />
  <button class="btn" bindtap="create">建立并提交导入</button>
</view>

<view class="card compact-row">
  <text>显示已归档文档</text>
  <switch checked="{{includeArchived}}" bindchange="onIncludeArchived" />
</view>

<view class="empty" wx:if="{{!loading && !items.length}}">当前范围暂无知识文档</view>
<view class="card document-card {{selectedId == item.id ? 'selected' : ''}}" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="select">
  <view class="document-title">#{{item.id}} {{item.title}}</view>
  <view>{{item.targetText}} · {{item.document_type}} · {{item.visibility}}</view>
  <view>状态：{{item.status}} · 当前版本：{{item.current_version || '无'}}</view>
  <view>导入：{{item.jobText}}</view>
</view>

<view class="card" wx:if="{{selected}}">
  <view class="section-title">版本与导入历史 · #{{selected.id}}</view>
  <view wx:for="{{selected.versions}}" wx:key="version">
    v{{item.version}} · {{item.status}} · {{item.created_at}}
  </view>
  <view class="history-heading">导入任务</view>
  <view wx:for="{{selected.ingestion_jobs}}" wx:key="version">
    v{{item.version}} · {{item.status}} · 尝试 {{item.attempt}} 次<text wx:if="{{item.error_code}}"> · {{item.error_code}}</text>
  </view>
  <block wx:if="{{selected.status != 'ARCHIVED'}}">
    <textarea class="source-box" placeholder="新版本知识正文" value="{{versionSourceText}}" data-field="versionSourceText" bindinput="onField" />
    <button class="btn" bindtap="createVersion">{{selected.status === 'ARCHIVED' ? '提交新版本并重新激活' : '提交新版本导入'}}</button>
    <button class="btn danger" bindtap="archive">归档文档</button>
  </block>
</view>

<button class="btn" bindtap="load">刷新知识状态</button>
