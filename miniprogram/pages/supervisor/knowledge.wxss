.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.picker,
input,
.source-box {
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  box-sizing: border-box;
  margin: 12rpx 0;
  padding: 18rpx;
  width: 100%;
}

.source-box {
  min-height: 220rpx;
}

.hint {
  color: #667085;
  font-size: 24rpx;
  margin-top: 10rpx;
}

.notice {
  color: #067647;
  margin: 16rpx 24rpx;
}

.compact-row {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.document-card.selected {
  border: 3rpx solid #1f4b99;
}

.document-title,
.history-heading {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.history-heading {
  margin-top: 20rpx;
}

.danger {
  background: #b42318;
}
