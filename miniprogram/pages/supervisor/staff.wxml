<input placeholder="小区 ID" value="{{propertyId}}" bindinput="onProperty" />
<button class="btn" bindtap="load">加载员工状态</button>
<view class="loading" wx:if="{{loading}}">加载中...</view>
<view class="empty" wx:if="{{!loading && !items.length}}">暂无员工状态</view>
<view class="card" wx:for="{{items}}" wx:key="employee_id">{{item.employee_id}} {{item.on_duty}}</view>
<view class="error" wx:if="{{error}}">{{error}}</view>
