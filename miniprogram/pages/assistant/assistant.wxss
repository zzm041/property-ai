.section-title,
.citation-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.picker,
input {
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  box-sizing: border-box;
  margin: 12rpx 0;
  padding: 18rpx;
  width: 100%;
}

.hint,
.locator,
.status {
  color: #667085;
  font-size: 24rpx;
  margin-bottom: 10rpx;
  word-break: break-all;
}
