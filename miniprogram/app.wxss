page {
  background: #f4f6f8;
  font-size: 28rpx;
  color: #1b1f24;
}

.card {
  background: #fff;
  margin: 24rpx;
  padding: 24rpx;
  border-radius: 12rpx;
}

.btn {
  margin: 16rpx 24rpx;
}

.error {
  color: #b42318;
  margin: 16rpx 24rpx;
}

.loading,
.empty {
  color: #667085;
  margin: 16rpx 24rpx;
}

.password-row {
  display: flex;
  align-items: center;
}

.grow {
  flex: 1;
}

.link {
  margin: 0 8rpx;
  font-size: 24rpx;
  background: transparent;
  color: #1f4b99;
}
