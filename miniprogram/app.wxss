page {
  min-height: 100%;
  box-sizing: border-box;
  background: #f3f6fa;
  font-size: 28rpx;
  color: #172033;
  line-height: 1.55;
  padding-bottom: env(safe-area-inset-bottom);
}

.card {
  background: #fff;
  margin: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e4eaf2;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 75, 153, 0.06);
}

button.btn,
.btn {
  box-sizing: border-box;
  min-height: 88rpx;
  margin: 18rpx 24rpx;
  border-radius: 14rpx;
  background: #1f4b99;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

button.btn::after,
.btn::after {
  border: 0;
}

.card > button.btn {
  width: 100%;
  margin-left: 0;
  margin-right: 0;
}

button.btn[disabled],
.btn[disabled] {
  background: #aab6ca;
  color: #f7f9fc;
}

.btn-secondary,
button.btn-secondary {
  background: #edf3ff;
  color: #1f4b99;
}

.btn-compact,
button.btn-compact {
  min-height: 64rpx;
  margin: 10rpx 0;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
}

.danger,
button.danger {
  background: #fff1f0;
  color: #b42318;
}

input,
textarea,
.field,
.input,
.picker {
  box-sizing: border-box;
  width: 100%;
  margin: 14rpx 0;
  padding: 20rpx 22rpx;
  border: 1rpx solid #cfd8e6;
  border-radius: 12rpx;
  background: #fff;
  color: #172033;
}

textarea {
  min-height: 176rpx;
}

.section-title,
.section-heading {
  margin-bottom: 14rpx;
  color: #102a56;
  font-size: 32rpx;
  font-weight: 700;
}

.section-heading {
  margin: 30rpx 24rpx 10rpx;
}

.field-label {
  margin-top: 18rpx;
  color: #344054;
  font-size: 26rpx;
  font-weight: 600;
}

.error {
  color: #b42318;
  margin: 16rpx 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #fff1f0;
}

.loading,
.empty,
.hint {
  color: #667085;
  margin: 16rpx 24rpx;
}

.notice {
  margin: 16rpx 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #ecfdf3;
  color: #027a48;
}

.switch-row,
.action-row,
.secondary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  flex-wrap: wrap;
}

.pending-media {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding: 8rpx 0;
}

.pending-media-image {
  flex: 0 0 auto;
  width: 176rpx;
  height: 176rpx;
  border-radius: 12rpx;
  background: #edf1f7;
}

.password-row {
  display: flex;
  align-items: center;
}

.grow {
  flex: 1;
}

.link {
  margin: 0 8rpx;
  font-size: 24rpx;
  background: transparent;
  color: #1f4b99;
}

@media (max-width: 360px) {
  .card {
    margin: 18rpx;
    padding: 22rpx;
  }

  button.btn,
  .btn {
    margin-left: 18rpx;
    margin-right: 18rpx;
    font-size: 26rpx;
  }

  .section-title,
  .section-heading {
    font-size: 30rpx;
  }
}
